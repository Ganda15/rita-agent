# =============================================================================
# RITA — variables d'environnement
#
# Copier ce fichier en `.env` et remplacer les valeurs. `.env` est ignoré par Git
# (`.gitignore:1`) : il ne doit JAMAIS être versionné.
#
# ⚠️ Réécrit le 18/08/2026. La version précédente ne permettait pas de démarrer le
#    projet : elle documentait `POSTGRES_URL` sur le port 5432 alors que le code lit
#    `DATABASE_URL` et que le serveur écoute sur 5433, et elle omettait trois
#    variables. Un évaluateur qui l'aurait suivie aurait échoué au premier lancement.
# =============================================================================

# --- Base de données ---------------------------------------------------------
# ⚠️ Le nom de la variable est bien DATABASE_URL (lu par sources/database.py,
#    db/importer.py, indicateurs/socle.py), et le port est 5433 — PAS 5432.
DATABASE_URL=postgresql://rita:motdepasse@localhost:5433/rita

# --- Clé d'API de RITA -------------------------------------------------------
# OBLIGATOIRE. L'API refuse de démarrer sans elle : une valeur par défaut serait
# devinable par quiconque lit le code (OWASP API2). Minimum 16 caractères.
#
#   Générer :  python -c "import secrets; print(secrets.token_urlsafe(32))"
RITA_API_KEY=remplacer-par-une-cle-generee-de-32-octets

# --- Passerelle MCP ----------------------------------------------------------
# Adresse de l'API que la passerelle interroge. Facultatif : par défaut
# http://127.0.0.1:8000 (le serveur de développement).
# La passerelle réutilise RITA_API_KEY ci-dessus — elle TRANSMET l'identité,
# elle ne la remplace pas. Sans clé, elle refuse de démarrer.
#   Pré-production Docker : http://127.0.0.1:8001
#   Serveur en ligne      : https://178-104-184-125.sslip.io
RITA_API_URL=http://127.0.0.1:8000

# --- Modèles de langage ------------------------------------------------------
# La cascade essaie les fournisseurs dans l'ordre indiqué (src/llm.py).
LLM_ORDRE=foundry,anthropic,openrouter

ANTHROPIC_API_KEY=votre_cle_ici
ANTHROPIC_MODEL=claude-sonnet-5

OPENROUTER_API_KEY=sk-or-votre-cle
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

AZURE_FOUNDRY_ENDPOINT=https://votre-ressource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=votre_cle_ici
AZURE_FOUNDRY_DEPLOYMENT=claude-opus-4-8

# --- Sources de données ------------------------------------------------------
# FRED — indicateurs macro-économiques. Clé gratuite :
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=votre_cle_ici

# Valeur par défaut des scripts de démonstration.
TICKER=MC.PA

# --- Traçage (NON ACTIVÉ) ----------------------------------------------------
# ⚠️ Volontairement commenté. Les décommenter ACTIVE l'envoi des prompts — donc
#    potentiellement de tickers détenus et de montants — vers LangChain Inc.
#    aux États-Unis. C'est le traitement T3 du registre RGPD
#    (`db/RGPD-registre-des-traitements.md`), classé « envisagé, non activé ».
#
#    Avant de les activer, lire le tableau de décision du registre : un traçage
#    auto-hébergé (Langfuse) supprime le transfert hors UE ; LangSmith le crée.
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=votre_cle_ici
