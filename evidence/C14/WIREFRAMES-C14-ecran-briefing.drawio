 pour MC.PA… Comptez quelques secondes (de 5 à 15 secondes)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=9.5;fontColor=#111827;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="636" width="420" height="13.5" as="geometry"/></mxCell><mxCell id="c88" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="44" y="656" width="512" height="40" as="geometry"/></mxCell><mxCell id="c89" value="b. Clé refusée (403)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8.5;fontColor=#374151;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="660" width="101" height="12.5" as="geometry"/></mxCell><mxCell id="c90" value="Clé d&#x27;API refusée. Saisissez-la à nouveau." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=9.5;fontColor=#111827;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="674" width="229" height="13.5" as="geometry"/></mxCell><mxCell id="c91" value="→ clé oubliée, retour à l&#x27;état 1" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8;fontColor=#1d4ed8;fontStyle=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="685" width="149" height="12" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="44" y="700" width="512" height="34" as="geometry"/></mxCell><mxCell id="c93" value="c. Code inconnu (502 « absent »)" style="text;html=0;strokeColor=none;fillColor=no