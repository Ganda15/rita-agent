lAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=12;fontColor=#111827;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="624" y="626" width="59" height="16" as="geometry"/></mxCell><mxCell id="c120" value="MC.PA — cours 378,55 EUR, variation sur une séance -0,25 %" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=9.5;fontColor=#111827;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="624" y="644" width="314" height="13.5" as="geometry"/></mxCell><mxCell id="c121" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="662" width="512" height="20" as="geometry"/></mxCell><mxCell id="c122" value="Texte conforme : aucune recommandation d&#x27;achat ou de vente détectée." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=9;fontColor=#166534;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632" y="667" width="348" height="13" as="geometry"/></mxCell><mxCell id="c123" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="688" width="512" height="32" as="geometry"/></mxCell><mxCell id="c124" value="Variante : Texte retenu par le garde-fou de sortie (motifs : …) : le modèle avait produit une" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8.5;fontColor=#991b1b;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632" y="692" width="448" height="12.5" as="geometry"/></mxCell><mxCell id="c125" value="recommandation, elle n&#x27;est pas diffusée.   (le verdict est un texte ; la couleur ne fait que le répéter)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8.5;fontColor=#991b1b;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632" y="704" width="501" height="12.5" as="geometry"/></mxCell><mxCell id="c126" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="730" width="512" height="9" as="geometry"/></mxCell><mxCell id="c127" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="748" width="512" height="9" as="geometry"/></mxCell><mxCell id="c128" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#e5e7eb;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="766" width="472" height="9" as="geometry"/></mxCell><mxCell id="c129" value="Référence de la requête : &lt;X-Request-ID&gt;   (à citer pour signaler un problème)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8.5;fontColor=#6b7280;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="624" y="786" width="377" height="12.5" as="geometry"/></mxCell><mxCell id="c130" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="624" y="802" width="512" height="18" as="geometry"/></mxCell><mxCell id="c131" value="▸ D&#x27;où vient ce texte ?   (données, modèle, garde-fou, référence)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=9;fontColor=#111827;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632" y="806" width="333" height="13" as="geometry"/></mxCell><mxCell id="c132" value="Le focus clavier et le lecteur d&#x27;écran sont déplacés sur la région « Briefing » à l&#x27;arrivée du texte ;" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8;fontColor=#1d4ed8;fontStyle=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="624" y="832" width="462" height="12" as="geometry"/></mxCell><mxCell id="c133" value="le texte du modèle est inséré comme du texte (textContent), jamais comme du HTML." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=8;fontColor=#1d4ed8;fontStyle=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="624" y="844" width="368" height="12" as="geometry"/></mxCell><mxCell id="c134" value="Légende : texte bleu en italique = annotation d&#x27;accessibilité ou de comportement." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=10;fontColor=#374151;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="896" width="459" height="14" as="geometry"/></mxCell><mxCell id="c135" value="Sources : frontend/briefing.html, frontend/briefing.js, frontend/style.css." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;fontSize=10;fontColor=#374151;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="914" width="426" height="14" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>