        <mxCell id="arret" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;API arrêtée&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;« Le serveur ne répond pas.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;Vérifiez que l&amp;#x27;API… »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="724" y="474" width="288" height="100" as="geometry" /></mxCell>
