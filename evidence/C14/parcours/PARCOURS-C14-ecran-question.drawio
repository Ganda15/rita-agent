        <mxCell id="refusee" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#9A3412&quot;&gt;Clé refusée (403)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;oubliée, puis&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;redemandée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="52" y="474" width="288" height="100" as="geometry" /></mxCell>
