        <mxCell id="bornes" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#9A3412&quot;&gt;Hors bornes (422)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;« de 3 à 500 caractères »,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;dit dans le statut&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="388" y="366" width="288" height="100" as="geometry" /></mxCell>
