# Les hooks git sont des scripts sh : toujours en LF, sinon un checkout en CRLF casse #!/bin/sh (19/09/2026)
.githooks/* text eol=lf

# Les fichiers du serveur (sprint 2) : deployer.sh est un script sh, et la chaine compare l empreinte de deployer.py
# a celle de la copie installee sur le serveur ; un CRLF casserait l un et changerait l autre (14/10/2026)
deploy/* text eol=lf
# docker-compose.yml est compare octet par octet a sa copie installee sur le serveur, et l image est construite
# sous Linux en LF : une copie en CRLF depuis Windows bloquerait toutes les livraisons (relecture du 14/10/2026)
docker-compose.yml text eol=lf
