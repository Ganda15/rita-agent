        <mxCell id="bd" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Bandeau de fraîcheur, écran 1 · export CSV des tuiles&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;lisible sans la couleur ; CSV pour un lecteur d&amp;#x27;écran ou un tableur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="856" y="206" width="488" height="56" as="geometry" /></mxCell>
