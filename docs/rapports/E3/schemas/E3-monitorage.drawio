        <mxCell id="tb" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Tableau de bord « RITA C11 » (créé par l&amp;#x27;API, 03/10)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tentatives par fournisseur, échecs compris (le repli se voit) ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;latence p95 de l&amp;#x27;appel au modèle · observations en ERROR ou WARNING&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="856" y="134" width="488" height="64" as="geometry" /></mxCell>
