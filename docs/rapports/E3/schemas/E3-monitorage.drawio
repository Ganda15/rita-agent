        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : surveiller le modèle, collecte, alerte et restitution" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1300" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E3, section 5 · src/traces.py, Langfuse Cloud (région UE), GitHub Actions · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="16" as="geometry" /></mxCell>
        <mxCell id="zc" value="&lt;b&gt;COLLECTE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="420" height="330" as="geometry" /></mxCell>
        <mxCell id="br" value="&lt;b&gt;Chaque briefing (POST /briefing)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une trace racine « briefing », identifiant = X-Request-ID&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une étape par nœud : scout, rag, redacteur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une génération par tentative de fournisseur :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  durée, jetons, modèle réel, erreur du repli&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;un score conforme_amf (verdict du garde-fou)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="118" width="388" height="120" as="geometry" /></mxCell>
        <mxCell id="jr" value="&lt;b&gt;Journal de l&amp;#x27;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une ligne par briefing servi ou refusé, avec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;l&amp;#x27;identifiant de requête ; jamais le texte&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="252" width="388" height="70" as="geometry" /></mxCell>
        <mxCell id="fr" value="&lt;b&gt;Fraîcheur des données&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;GET /donnees/fraicheur : retard en jours ouvrés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la panne la plus fréquente : la collecte d&amp;#x27;hier&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="336" width="388" height="70" as="geometry" /></mxCell>
        <mxCell id="lf" value="&lt;b&gt;Langfuse Cloud, région UE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;reçoit les traces (palier gratuit)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;calcule latence, volumes, erreurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;accès : compte du propriétaire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;reçoit des chiffres de marché, jamais une position&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="118" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="zr" value="&lt;b&gt;RESTITUTION&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="520" height="170" as="geometry" /></mxCell>
        <mxCell id="tb" value="&lt;b&gt;Tableau de bord « RITA C11 » (créé par l&amp;#x27;API, 03/10)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;générations par fournisseur (le repli se voit) · latence p95 de&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;l&amp;#x27;appel au modèle · observations en ERROR ou WARNING&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="856" y="118" width="488" height="64" as="geometry" /></mxCell>
        <mxCell id="bd" value="&lt;b&gt;Bandeau de fraîcheur, écran 1 · export CSV des tuiles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;lisible sans la couleur ; CSV pour un lecteur d&amp;#x27;écran ou un tableur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="856" y="190" width="488" height="56" as="geometry" /></mxCell>
        <mxCell id="za" value="&lt;b&gt;ALERTE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="520" height="140" as="geometry" /></mxCell>
        <mxCell id="al" value="&lt;b&gt;2 règles Langfuse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ERROR sur 24 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;aucune trace en 24 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;à régler par le&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;propriétaire du compte&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="856" y="308" width="230" height="98" as="geometry" /></mxCell>
        <mxCell id="gh" value="&lt;b&gt;alerte-incident.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;repository_dispatch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ouvre ou commente une&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;issue « incident »&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;testé à la main : #71&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1110" y="308" width="234" height="98" as="geometry" /></mxCell>
        <mxCell id="sb" value="&lt;b&gt;Bac à sable : la suite de tests ne trace jamais&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;tests/conftest.py coupe le traçage (INC-006) ; le banc C7 aussi (LANGFUSE_TRACING_ENABLED=false) ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;doubles de client dans tests/test_traces*.py, test_trace_chemin.py (l&amp;#x27;ordre exact des étapes)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="660" height="70" as="geometry" /></mxCell>
        <mxCell id="lim" value="&lt;b&gt;Ce qui manque&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;alertes non réglées · quinze traces factices du 02/10 à supprimer ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;serveur de production pas encore tracé (code du 19/08) · coût OpenRouter à zéro&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="640" height="70" as="geometry" /></mxCell>
        <mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="br" target="lf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="lf" target="tb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="lf" target="al"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="al" target="gh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="fr" target="bd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="Boîtes pleines : présent et prouvé. Pointillé orange : à faire. Gris : service externe. Preuves : evidence/C11/." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1320" height="20" as="geometry" /></mxCell>
