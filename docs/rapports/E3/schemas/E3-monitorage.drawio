        <mxCell id="lf" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;Langfuse Cloud, région UE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reçoit les traces (palier gratuit)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;calcule latence, volumes, erreurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;accès : compte du propriétaire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reçoit des chiffres de marché, jamais une position&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="134" width="300" height="120" as="geometry" /></mxCell>
