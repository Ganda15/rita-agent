<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="RITA" version="24.0.0" type="device">
  <diagram id="E3-architecture" name="RITA : le chemin d&#x27;un briefing, et tout ce qui le regarde passer">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1420" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : le chemin d&#x27;un briefing, et tout ce qui le regarde passer" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1400" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E3, section 2 · état du code au 4 octobre 2026 · un seul utilisateur, un modèle fourni, aucune action" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1400" height="16" as="geometry" /></mxCell>
        <mxCell id="zc" value="&lt;b&gt;CLIENTS (C10)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="300" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;Interface web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;frontend/, HTML, CSS, JS sans build&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;3 écrans : portefeuille, indicateurs, briefing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;clé saisie, sessionStorage, 403 affiché&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="118" width="218" height="72" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;Passerelle MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;passerelle_mcp/serveur.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;3 outils en lecture seule&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;appelle l&amp;#x27;API par HTTP, avec la clé&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="204" width="218" height="72" as="geometry" /></mxCell>
        <mxCell id="curl" value="&lt;b&gt;curl, /docs (OpenAPI 3.1.0)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;POST /briefing?ticker=MC.PA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;le seul chemin vers le modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;aucun texte libre : un ticker&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="218" height="72" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;b&gt;api/main.py : l&amp;#x27;API (C9)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;middleware : un request_id par requête (X-Request-ID)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;clé X-API-Key, 16 car. min., temps constant, 403&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;aucune clé par défaut (INC-001, OWASP API2)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;14 chemins ; /briefing est le seul qui parle au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;journal : servi, refusé, 502 (request_id, jamais le texte)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="118" width="290" height="120" as="geometry" /></mxCell>
        <mxCell id="zg" value="&lt;b&gt;graph/workflow.py : LangGraph, 3 nœuds, arêtes fixes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="262" width="290" height="330" as="geometry" /></mxCell>
        <mxCell id="scout" value="&lt;b&gt;scout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;lit PostgreSQL : 13 indicateurs par valeur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;fraîcheur en jours ouvrés, cotation périmée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="290" width="258" height="58" as="geometry" /></mxCell>
        <mxCell id="rag" value="&lt;b&gt;rag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;garde-fou d&amp;#x27;ENTRÉE : intention AMF, 7 motifs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  100 % / 0 % (03/10), avant tout accès à la base&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ChromaDB : filtre ticker puis hybride dense + BM25&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;refus OUT_OF_CORPUS si rien ne cite la valeur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="362" width="258" height="86" as="geometry" /></mxCell>
        <mxCell id="red" value="&lt;b&gt;redacteur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;agents/analyst.py : prompt (interdit AMF écrit)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;src/llm.py : la cascade&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="462" width="258" height="58" as="geometry" /></mxCell>
        <mxCell id="casc" value="&lt;b&gt;Foundry (gpt-5.4) → Anthropic → OpenRouter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une génération tracée par essai ; repli ≈ 0,3 s&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="532" width="258" height="48" as="geometry" /></mxCell>
        <mxCell id="sortie" value="&lt;b&gt;guardrails/sortie.py : garde-fou de SORTIE (C17)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;9 motifs, 70 % / 0 % (03/10) ; échec fermé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;texte remplacé par un refus, HTTP 200, conforme_amf=false&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="612" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="rep" value="&lt;b&gt;Réponse JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ticker, prix, variation, briefing, conforme_amf,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;motifs_amf ; en-tête X-Request-ID&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="700" width="290" height="56" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 18 (E1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;10 tables, 1 vue, dix ans de cotations&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;écrit par le seul pipeline&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="190" height="58" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;ChromaDB (index)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;articles vectorisés, reconstruit chaque nuit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;1 359 documents (27/09)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="362" width="190" height="58" as="geometry" /></mxCell>
        <mxCell id="nuit" value="&lt;b&gt;Collecte nocturne, 19 h&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;pipelines/ingest.py, tâche planifiée Windows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;yfinance, RSS, scraping, FRED, BCE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;garde-fou d&amp;#x27;INJECTION sur les articles :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  12 motifs, 70 % / 0 % (03/10)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;40 journaux du 24/08 au 02/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="612" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="zo" value="&lt;b&gt;OBSERVABILITÉ (C11, C20)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="380" height="600" as="geometry" /></mxCell>
        <mxCell id="lf" value="&lt;b&gt;Langfuse Cloud, région UE (Irlande)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une trace par briefing, identifiant = request_id :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  briefing  (verdict AMF, note conforme_amf)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  ├─ scout&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  ├─ rag ─ garde-fou-entree&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  ├─ redacteur ─ briefing-llm ─ llm-&amp;lt;fournisseur&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  └─ garde-fou-sortie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;jetons, erreur du repli, niveau WARNING au refus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;première trace réelle : 02/10 18:39 ; palier gratuit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1056" y="118" width="348" height="196" as="geometry" /></mxCell>
        <mxCell id="fr" value="&lt;b&gt;GET /donnees/fraicheur + bandeau&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;retard en jours ouvrés, 3 états, lisible sans couleur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la panne la plus fréquente : la collecte d&amp;#x27;hier&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1056" y="416" width="348" height="58" as="geometry" /></mxCell>
        <mxCell id="al" value="&lt;b&gt;Alertes (2, palier gratuit) → GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;.github/workflows/alerte-incident.yml&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ouvre ou commente une issue « incident »&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;bouton manuel pour prouver la chaîne&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1056" y="330" width="348" height="70" as="geometry" /></mxCell>
        <mxCell id="tb" value="&lt;b&gt;Tableau de bord « RITA C11 » (03/10, par l&amp;#x27;API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;générations par fournisseur · p95 de briefing-llm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;observations en ERROR ou WARNING&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1056" y="490" width="348" height="56" as="geometry" /></mxCell>
        <mxCell id="cout" value="&lt;b&gt;Coût par briefing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;à zéro pour OpenRouter : nom de modèle absent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;de la grille de prix Langfuse ; à corriger&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1056" y="562" width="348" height="56" as="geometry" /></mxCell>
        <mxCell id="sand" value="&lt;b&gt;Bac à sable&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la suite de tests ne trace jamais&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;(conftest.py, INC-006) ; doubles de client&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;805 tests, 94,70 % (04/10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="728" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="test" value="&lt;b&gt;Tests en CI à chaque poussée&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;test.yml : données, puis suite + couverture ≥ 90 %,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;garde-fous mesurés, portes xfail strict&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="700" y="814" width="220" height="56" as="geometry" /></mxCell>
        <mxCell id="f0" value="HTTP + clé" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="HTTP + clé" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="mcp" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="curl" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="api" target="scout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="scout" target="rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="rag" target="red"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="red" target="casc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="casc" target="sortie"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="sortie" target="rep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="lecture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="pg" target="scout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="lecture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="chroma" target="rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="nuit" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="indexe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="nuit" target="chroma"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" value="trace (racine et générations)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="api" target="lf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="lf" target="al"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="Boîtes pleines : code présent et testé au 04/10/2026. Boîtes pointillées orange : conçu, non construit. Mesures datées dans le rapport, section 6." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1420" height="20" as="geometry" /></mxCell>
      </root>
