        <mxCell id="zg" value="LangGraph (graph/workflow.py), arêtes fixes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="340" y="278" width="358" height="368" as="geometry" /></mxCell>
        <mxCell id="zo" value="OBSERVABILITÉ (C11, C20)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1030" y="106" width="420" height="570" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Interface web&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;frontend/, HTML, CSS, JS sans build&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 écrans : portefeuille, indicateurs, briefing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé saisie, sessionStorage, 403 affiché&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="134" width="242" height="82" as="geometry" /></mxCell>
        <mxCell id="web-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="134" width="7" height="82" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Passerelle MCP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;passerelle_mcp/serveur.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 outils en lecture seule&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;appelle l&amp;#x27;API par HTTP, avec la clé&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="226" width="242" height="82" as="geometry" /></mxCell>
        <mxCell id="mcp-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="226" width="7" height="82" as="geometry" /></mxCell>
        <mxCell id="curl" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;curl, /docs (OpenAPI 3.1.0)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;POST /briefing?ticker=MC.PA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le seul chemin vers le modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucun texte libre : un ticker&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="318" width="242" height="82" as="geometry" /></mxCell>
        <mxCell id="curl-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="318" width="7" height="82" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;api/main.py : l&amp;#x27;API (C9)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;middleware : un request_id par requête (X-Request-ID)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé X-API-Key, 16 car. min., temps constant, 403&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucune clé par défaut (INC-001, OWASP API2)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;14 chemins ; /briefing est le seul qui parle au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;journal : servi, refusé, 502 (request_id, jamais le texte)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="134" width="358" height="120" as="geometry" /></mxCell>
        <mxCell id="api-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="134" width="7" height="120" as="geometry" /></mxCell>
        <mxCell id="scout" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;scout&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;lit PostgreSQL : 13 indicateurs par valeur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;âge du dernier cours en jours calendaires, cotation périmée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="308" width="326" height="66" as="geometry" /></mxCell>
        <mxCell id="scout-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="308" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="rag" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;rag&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;garde-fou d&amp;#x27;ENTRÉE : intention AMF, 7 motifs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  100 % / 0 % (03/10), avant tout accès à la base&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;ChromaDB : filtre ticker puis hybride dense + BM25&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;refus OUT_OF_CORPUS si rien ne cite la valeur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="388" width="326" height="98" as="geometry" /></mxCell>
        <mxCell id="rag-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="388" width="7" height="98" as="geometry" /></mxCell>
        <mxCell id="red" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;redacteur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/analyst.py : prompt (interdit AMF écrit)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;src/llm.py : la cascade&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="500" width="326" height="66" as="geometry" /></mxCell>
        <mxCell id="red-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="500" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="casc" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Foundry (gpt-5.4) → Anthropic → OpenRouter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;une génération tracée par essai ; repli ≈ 0,3 s&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="580" width="326" height="52" as="geometry" /></mxCell>
        <mxCell id="casc-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="580" width="7" height="52" as="geometry" /></mxCell>
        <mxCell id="sortie" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;guardrails/sortie.py : garde-fou de SORTIE (C17)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;9 motifs, 70 % / 0 % (03/10) ; échec fermé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;texte remplacé par un refus, HTTP 200, conforme_amf=false&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="664" width="358" height="70" as="geometry" /></mxCell>
        <mxCell id="sortie-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="664" width="7" height="70" as="geometry" /></mxCell>
        <mxCell id="rep" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Réponse JSON&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;ticker, prix, variation, briefing, conforme_amf,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;motifs_amf ; en-tête X-Request-ID&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="752" width="358" height="66" as="geometry" /></mxCell>
        <mxCell id="rep-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="752" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;PostgreSQL 18 (E1)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;10 tables, 1 vue, dix ans de cotations&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;écrit par le seul pipeline&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="730" y="308" width="260" height="66" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="730" y="308" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;ChromaDB (index)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;articles vectorisés, reconstruit chaque nuit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;1 359 documents (27/09)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="730" y="388" width="240" height="66" as="geometry" /></mxCell>
        <mxCell id="chroma-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="730" y="388" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="nuit" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Collecte nocturne, 19 h&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;pipelines/ingest.py, tâche planifiée Windows&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;yfinance, RSS, scraping, FRED, BCE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;garde-fou d&amp;#x27;INJECTION sur les articles :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  12 motifs, 70 % / 0 % (03/10)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;40 journaux du 24/08 au 02/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="730" y="664" width="260" height="114" as="geometry" /></mxCell>
        <mxCell id="nuit-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="730" y="664" width="7" height="114" as="geometry" /></mxCell>
        <mxCell id="lf" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Langfuse Cloud, région UE (Irlande)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;une trace par briefing, identifiant = request_id :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  briefing  (verdict AMF, note conforme_amf)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  ├─ scout&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  ├─ rag ─ garde-fou-entree&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  ├─ redacteur ─ briefing-llm ─ llm-&amp;lt;fournisseur&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  └─ garde-fou-sortie&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;jetons, erreur du repli, niveau WARNING au refus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;première trace réelle : 02/10 18:39 ; palier gratuit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="134" width="388" height="176" as="geometry" /></mxCell>
        <mxCell id="lf-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="134" width="7" height="176" as="geometry" /></mxCell>
        <mxCell id="fr" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;GET /donnees/fraicheur + bandeau&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;retard en jours ouvrés, 3 états, lisible sans couleur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;la panne la plus fréquente : la collecte d&amp;#x27;hier&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="432" width="388" height="66" as="geometry" /></mxCell>
        <mxCell id="fr-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="432" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="al" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Alertes (2, palier gratuit) → GitHub Actions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;erreurs de fournisseur ; p95 de l&amp;#x27;appel au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;alerte-incident.yml ouvre une issue « incident »&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;réglées le 04/10, ont sonné : issue #77&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="334" width="388" height="82" as="geometry" /></mxCell>
        <mxCell id="al-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="334" width="7" height="82" as="geometry" /></mxCell>
        <mxCell id="tb" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Tableau de bord « RITA C11 » (03/10, par l&amp;#x27;API)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tentatives par fournisseur, échecs compris · p95 de briefing-llm&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;observations en ERROR ou WARNING&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="514" width="388" height="66" as="geometry" /></mxCell>
        <mxCell id="tb-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="514" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="cout" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Coût par briefing&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;à zéro pour OpenRouter : nom de modèle absent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;de la grille de prix Langfuse ; à corriger&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="596" width="388" height="66" as="geometry" /></mxCell>
