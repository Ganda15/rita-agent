  <diagram id="E3-chaine-livraison" name="RITA : la chaîne de livraison continue, du poste au serveur">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : la chaîne de livraison continue, du poste au serveur" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1300" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E3, section 7 · cinq workflows GitHub Actions · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="16" as="geometry" /></mxCell>
        <mxCell id="zp" value="&lt;b&gt;POSTE D&amp;#x27;ERA&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="260" as="geometry" /></mxCell>
        <mxCell id="dev" value="&lt;b&gt;Branche develop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;un commit = une intention&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;tests écrits avant le code (TDD)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;git push origin develop&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="118" width="228" height="70" as="geometry" /></mxCell>
        <mxCell id="hook" value="&lt;b&gt;Hook pre-push (.githooks/)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;refuse la poussée directe sur main&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;activé une fois par clone&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="202" width="228" height="60" as="geometry" /></mxCell>
        <mxCell id="dod" value="&lt;b&gt;scripts/verifier_livrable.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;Definition of Done : tests, liens,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ETAT et CHANGELOG, arbre propre&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="276" width="228" height="60" as="geometry" /></mxCell>
        <mxCell id="zgh" value="&lt;b&gt;GITHUB (dépôt privé Ganda15/rita-agent)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="620" height="500" as="geometry" /></mxCell>
        <mxCell id="test" value="&lt;b&gt;test.yml : à chaque poussée et PR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;job pytest : 1. TEST DES DONNÉES (260 verts, 5 s)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  2. suite + couverture ≥ 90 % (.coveragerc)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;job evals : garde-fous mesurés,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  portes non compensables (xfail strict à 85 %)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;778 passed, 29 skipped, 94,70 % (04/10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="118" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="pr" value="&lt;b&gt;revue-pr.yml : chaque PR vers main&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;relecture adversariale automatisée&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;(action officielle, jeton d&amp;#x27;abonnement en secret)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;grille de lecture : AGENTS.md et les règles du dépôt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;24 PR fusionnées au 04/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="664" y="118" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="main" value="&lt;b&gt;Branche main&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ne bouge que par une PR depuis develop&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;un livrable = un tag livrable-E&amp;lt;n&amp;gt;-v&amp;lt;k&amp;gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="236" width="280" height="56" as="geometry" /></mxCell>
        <mxCell id="liv" value="&lt;b&gt;livraison.yml : poussée, PR, et tag livrable-*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;1. tests, porte de livraison (rien n&amp;#x27;est construit si rouge)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;2. construction de l&amp;#x27;image, jamais publiée ici&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;3. l&amp;#x27;image construite démarre et répond sur /health&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;4. l&amp;#x27;accès est restreint : 403 sans clé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;5. publication sur ghcr.io/ganda15/rita-api, seulement sur un tag (issue #22 : avant, la publication précédait la vérification)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="310" width="588" height="120" as="geometry" /></mxCell>
        <mxCell id="gisk" value="&lt;b&gt;scan-giskard.yml : manuel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;scan d&amp;#x27;attaques, deux frontières&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;plafond de coût saisi ; run 9 le 20/09&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="664" y="236" width="280" height="56" as="geometry" /></mxCell>
        <mxCell id="alerte" value="&lt;b&gt;alerte-incident.yml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;reçu de Langfuse (repository_dispatch)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ou bouton manuel ; ouvre ou commente&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une issue « incident » ; label créé&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="664" y="524" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;Image sur GHCR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;python:3.13-slim, deux étapes, non-root (UID 10001)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;ghcr.io/ganda15/rita-api:livrable-E&amp;lt;n&amp;gt;-v&amp;lt;k&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;jamais publiée pour de vrai au 03/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="446" width="588" height="70" as="geometry" /></mxCell>
        <mxCell id="zs" value="&lt;b&gt;SERVEUR HETZNER (CX23, 4 Go, HTTPS Caddy)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="360" height="260" as="geometry" /></mxCell>
        <mxCell id="srv" value="&lt;b&gt;docker compose (manuel, par SSH)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;pull de l&amp;#x27;image taguée, up -d --force-recreate api&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;conteneur en lecture seule, no-new-privileges&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;variables Langfuse transmises depuis le 02/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="118" width="328" height="86" as="geometry" /></mxCell>
        <mxCell id="gel" value="&lt;b&gt;Copie figée depuis le 19/08/2026&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;première livraison de cette chaîne à faire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;les variables Langfuse ne sont pas encore posées&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="220" width="328" height="56" as="geometry" /></mxCell>
        <mxCell id="lfs" value="&lt;b&gt;Langfuse Cloud UE ← traces du serveur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;dès que les variables y sont&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="290" width="328" height="44" as="geometry" /></mxCell>
        <mxCell id="zm" value="&lt;b&gt;CONÇU, NON CONSTRUIT (Mardik ③, Industrialisation)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1000" y="380" width="360" height="210" as="geometry" /></mxCell>
        <mxCell id="rb" value="&lt;b&gt;rollback.yml : retour arrière&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;tag précédent redéployé, jamais reconstruit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="408" width="328" height="44" as="geometry" /></mxCell>
        <mxCell id="man" value="&lt;b&gt;Manifeste de version, GET /version&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;modèle daté, prompt_version, config, index&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="462" width="328" height="44" as="geometry" /></mxCell>
        <mxCell id="filtre" value="&lt;b&gt;Filtre de chemin + gate sur le vrai modèle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;porte payante seulement si prompt ou jeu changent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="516" width="328" height="44" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;b&gt;Ce que la chaîne coche pour C13&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;test → construction → démarrage vérifié →&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;accès vérifié → publication sur tag,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;exécuté par la plateforme à chaque poussée.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;Un Dockerfile seul ne coche aucun critère.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="rouge" value="&lt;b&gt;La CI a refusé, et c&amp;#x27;était juste&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;28/09 : pandas reconstruit (#23, non épinglé)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;03/10 : dix exécutions rouges, tests liés au&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;poste (INC-007), corrigé le jour même&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;aucune alerte sur une exécution rouge&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="f0" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="dev" target="test"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="puis la PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="test" target="pr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="fusion relue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="pr" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="tag livrable-*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="main" target="liv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="étape 5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="liv" target="ghcr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="pull" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="ghcr" target="srv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="refuse le direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="hook" target="main"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="alerte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="lfs" target="alerte"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="Boîtes pleines : existe et tourne (dates mesurées). Pointillé orange : conçu, non construit. Flèches pointillées : manuel ou non encore exécuté." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1320" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
