        <mxCell id="alerte" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;alerte-incident.yml&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reçu de Langfuse (repository_dispatch)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;ou bouton manuel ; ouvre ou commente&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;une issue « incident » ; label créé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;a sonné pour de vrai le 04/10 (#77)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="664" y="602" width="280" height="98" as="geometry" /></mxCell>
        <mxCell id="alerte-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="664" y="602" width="7" height="98" as="geometry" /></mxCell>
        <mxCell id="ghcr" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;Image sur GHCR&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;python:3.13-slim, deux étapes, non-root (UID 10001)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;ghcr.io/ganda15/rita-api:livrable-E&amp;lt;n&amp;gt;-v&amp;lt;k&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;jamais publiée pour de vrai au 03/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="356" y="500" width="588" height="82" as="geometry" /></mxCell>
        <mxCell id="ghcr-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="356" y="500" width="7" height="82" as="geometry" /></mxCell>
        <mxCell id="srv" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;docker compose (manuel, par SSH)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;pull de l&amp;#x27;image taguée, up -d --force-recreate api&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;conteneur en lecture seule, no-new-privileges&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;variables Langfuse transmises depuis le 02/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="134" width="328" height="86" as="geometry" /></mxCell>
        <mxCell id="srv-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="134" width="7" height="86" as="geometry" /></mxCell>
        <mxCell id="gel" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Copie figée depuis le 19/08/2026&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;première livraison de cette chaîne à faire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;les variables Langfuse ne sont pas encore posées&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="234" width="328" height="66" as="geometry" /></mxCell>
        <mxCell id="gel-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="234" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="lfs" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Langfuse Cloud UE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;traces du poste depuis le 02/10 ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;du serveur dès que les variables y sont&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="314" width="328" height="66" as="geometry" /></mxCell>
        <mxCell id="lfs-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="314" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="rb" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;rollback.yml : retour arrière&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tag précédent redéployé, jamais reconstruit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="444" width="328" height="50" as="geometry" /></mxCell>
        <mxCell id="rb-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="444" width="7" height="50" as="geometry" /></mxCell>
        <mxCell id="man" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Manifeste de version, GET /version&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;modèle daté, prompt_version, config, index&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="506" width="328" height="50" as="geometry" /></mxCell>
        <mxCell id="man-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="506" width="7" height="50" as="geometry" /></mxCell>
        <mxCell id="filtre" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Filtre de chemin + gate sur le vrai modèle&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;porte payante seulement si prompt ou jeu changent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="568" width="328" height="50" as="geometry" /></mxCell>
        <mxCell id="filtre-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1016" y="568" width="7" height="50" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Ce que la chaîne coche pour C13&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;test → construction → démarrage vérifié →&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;accès vérifié → publication sur tag,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;exécuté par la plateforme à chaque poussée.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;Un Dockerfile seul ne coche aucun critère.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="note-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="7" height="100" as="geometry" /></mxCell>
        <mxCell id="rouge" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;La CI a refusé, et c&amp;#x27;était juste&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;28/09 : pandas reconstruit (#23, non épinglé)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;03/10 : dix exécutions rouges, tests liés au&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;poste (INC-007), corrigé le jour même&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucune alerte sur une exécution rouge&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="260" height="98" as="geometry" /></mxCell>
