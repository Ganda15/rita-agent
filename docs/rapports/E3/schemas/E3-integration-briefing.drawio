        <mxCell id="e5xx" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#C62828&quot;&gt;502, 500 : pannes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;502 : le graphe échoue ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;500 : aucun fournisseur,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;message générique (#75)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1112" y="306" width="236" height="100" as="geometry" /></mxCell>
