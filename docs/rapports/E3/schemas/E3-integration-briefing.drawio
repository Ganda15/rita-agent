<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="RITA" version="24.0.0" type="device">
  <diagram id="E3-integration-briefing" name="RITA : une demande de briefing, de l&#x27;écran au modèle et retour">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1320" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : une demande de briefing, de l&#x27;écran au modèle et retour" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1300" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E3, section 4 · écran 3 (frontend/briefing.html, briefing.js) · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="16" as="geometry" /></mxCell>
        <mxCell id="u" value="&lt;b&gt;1. L&amp;#x27;utilisateur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;saisit la clé (champ masqué)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;choisit un code dans la liste&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  (GET /donnees/valeurs, facultatif)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;envoie : bouton ou touche Entrée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="e" value="&lt;b&gt;2. L&amp;#x27;écran envoie&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;POST /briefing?ticker=MC.PA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;en-tête X-API-Key (sessionStorage)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;annonce l&amp;#x27;attente : 5 à 15 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  (zone de statut, aria-live)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="250" height="120" as="geometry" /></mxCell>
        <mxCell id="a" value="&lt;b&gt;3. L&amp;#x27;API vérifie&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;clé : 16 car. min., temps constant&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;identifiant de requête X-Request-ID&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;puis le graphe : scout, rag, redacteur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="250" height="120" as="geometry" /></mxCell>
        <mxCell id="m" value="&lt;b&gt;4. Le modèle écrit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;cascade Foundry → Anthropic → OpenRouter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;puis garde-fou de SORTIE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  (texte retenu si recommandation)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="250" height="120" as="geometry" /></mxCell>
        <mxCell id="ok" value="&lt;b&gt;5. L&amp;#x27;écran affiche&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;le verdict EN MOTS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;le texte par textContent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la référence de requête&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;focus posé sur le résultat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="z" value="&lt;b&gt;LES RÉPONSES QUI NE SONT PAS UN BRIEFING, ET CE QUE L&amp;#x27;ÉCRAN EN FAIT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1320" height="190" as="geometry" /></mxCell>
        <mxCell id="e403" value="&lt;b&gt;403 : clé refusée&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la clé est oubliée (sessionStorage)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;retour à la saisie, message en clair&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="290" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="e502" value="&lt;b&gt;502 : valeur absente de la base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;« Valeur introuvable : … n&amp;#x27;est pas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;dans l&amp;#x27;univers suivi »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="376" y="290" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="e500" value="&lt;b&gt;500 : aucun fournisseur ne répond&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;mesuré le 03/10 : « Erreur 500 » générique,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sans fuite ; message dédié prévu (#75)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="696" y="290" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="enet" value="&lt;b&gt;Aucune réponse du serveur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;pas de code HTTP à lire : try/catch,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;« Le serveur ne répond pas »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1016" y="290" width="328" height="70" as="geometry" /></mxCell>
        <mxCell id="ecle" value="&lt;b&gt;Défaut connu : la clé est mémorisée avant d&amp;#x27;avoir servi (#73)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;les écrans 1 et 2 attendent un appel réussi ; l&amp;#x27;écran 3 non. Correction après le gel du 15/10, test d&amp;#x27;abord.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="372" width="620" height="62" as="geometry" /></mxCell>
        <mxCell id="emcp" value="&lt;b&gt;Le deuxième client : la passerelle MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;mêmes routes, même clé ; trois outils en lecture seule ; aucun outil ne donne accès à /briefing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="696" y="372" width="648" height="62" as="geometry" /></mxCell>
        <mxCell id="t" value="&lt;b&gt;Preuves&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;tests/test_frontend.py (72, statiques) · tests/test_smoke_ui.py (7, vrai navigateur, /briefing intercepté) · tests/test_health.py, test_api_donnees.py (l&amp;#x27;API) · evidence/C10/&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1320" height="50" as="geometry" /></mxCell>
        <mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="u" target="e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="e" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="a" target="m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="m" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="sans clé" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="a" target="e403"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="a" target="e502"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="m" target="e500"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="Boîtes pleines : comportement présent et testé. Pointillé orange : écart connu, corrigé après le gel. Flèches pointillées : réponses d&#x27;erreur." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1320" height="20" as="geometry" /></mxCell>
      </root>
