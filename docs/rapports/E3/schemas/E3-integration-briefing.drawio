        <mxCell id="z" value="LES RÉPONSES QUI NE SONT PAS UN BRIEFING, ET CE QUE L&#x27;ÉCRAN EN FAIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="1320" height="256" as="geometry" /></mxCell>
        <mxCell id="u" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;1. L&amp;#x27;utilisateur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;saisit la clé (masquée),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;choisit une valeur dans&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;la liste de l&amp;#x27;univers suivi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="244" height="100" as="geometry" /></mxCell>
