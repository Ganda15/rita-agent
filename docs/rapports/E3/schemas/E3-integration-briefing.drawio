        <mxCell id="ecle" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#C62828&quot;&gt;La clé gardée trop tôt (#73), non corrigé&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;briefing et question : dès l&amp;#x27;envoi ; tableau de bord :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;après une panne réseau ou une erreur 500&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="426" width="500" height="80" as="geometry" /></mxCell>
