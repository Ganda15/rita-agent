        <mxCell id="ttl" value="RITA : une demande de briefing, de l&#x27;écran au modèle et retour" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#0B2A5B;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1300" height="36" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E3, section 4 · écran 3 (frontend/briefing.html, briefing.js) · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=15;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="22" as="geometry" /></mxCell>
        <mxCell id="z" value="LES RÉPONSES QUI NE SONT PAS UN BRIEFING, ET CE QUE L&#x27;ÉCRAN EN FAIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="1320" height="266" as="geometry" /></mxCell>
        <mxCell id="u" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;1. L&amp;#x27;utilisateur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;saisit la clé (champ masqué)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;choisit un code dans la liste,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;remplie par GET /donnees/valeurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;envoie : bouton ou touche Entrée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="236" height="128" as="geometry" /></mxCell>
        <mxCell id="u-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="7" height="128" as="geometry" /></mxCell>
        <mxCell id="e" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;2. L&amp;#x27;écran envoie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;POST /briefing?ticker=MC.PA&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;en-tête X-API-Key&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;annonce l&amp;#x27;attente : 5 à 15 s&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  (zone de statut, aria-live)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="302" y="120" width="256" height="128" as="geometry" /></mxCell>
        <mxCell id="e-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="302" y="120" width="7" height="128" as="geometry" /></mxCell>
        <mxCell id="a" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;3. L&amp;#x27;API vérifie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé : 16 car. min., temps constant&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;identifiant X-Request-ID&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;puis le graphe :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  scout, rag, redacteur&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="584" y="120" width="262" height="128" as="geometry" /></mxCell>
        <mxCell id="a-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="584" y="120" width="7" height="128" as="geometry" /></mxCell>
        <mxCell id="m" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;4. Le modèle écrit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;cascade de fournisseurs :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  Foundry → Anthropic → OpenRouter&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;puis garde-fou de SORTIE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  (texte retenu si recommandation)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="872" y="120" width="262" height="128" as="geometry" /></mxCell>
        <mxCell id="m-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="872" y="120" width="7" height="128" as="geometry" /></mxCell>
        <mxCell id="ok" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;5. L&amp;#x27;écran affiche&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le verdict EN MOTS&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le texte (textContent)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;la référence de requête&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;focus sur le résultat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="200" height="128" as="geometry" /></mxCell>
        <mxCell id="ok-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="7" height="128" as="geometry" /></mxCell>
        <mxCell id="enet" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Pas de réponse du serveur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;exception attrapée (try/catch) :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;« Le serveur ne répond pas.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  Vérifiez que l&amp;#x27;API est démarrée. »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="307" height="88" as="geometry" /></mxCell>
        <mxCell id="enet-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="7" height="88" as="geometry" /></mxCell>
        <mxCell id="e403" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;403 : clé refusée&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;la clé est oubliée (sessionStorage)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;retour à la saisie,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;message en clair&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="383" y="356" width="307" height="88" as="geometry" /></mxCell>
        <mxCell id="e403-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="383" y="356" width="7" height="88" as="geometry" /></mxCell>
        <mxCell id="e502" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;502 : valeur absente de la base&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;« Valeur introuvable : … n&amp;#x27;est pas&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  dans l&amp;#x27;univers suivi. »&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="356" width="307" height="88" as="geometry" /></mxCell>
        <mxCell id="e502-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="710" y="356" width="7" height="88" as="geometry" /></mxCell>
        <mxCell id="e500" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;500 : aucun fournisseur ne répond&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;mesuré le 03/10 : « Erreur 500 »&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;générique, sans fuite ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;message dédié prévu (#75)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1037" y="356" width="307" height="88" as="geometry" /></mxCell>
        <mxCell id="e500-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1037" y="356" width="7" height="88" as="geometry" /></mxCell>
        <mxCell id="ecle" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Défaut connu : la clé est mémorisée avant d&amp;#x27;avoir servi (#73)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;les écrans 1 et 2 attendent un appel réussi ; l&amp;#x27;écran 3 non.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;Correction après le gel du 15/10, test d&amp;#x27;abord.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="460" width="634" height="68" as="geometry" /></mxCell>
        <mxCell id="ecle-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="460" width="7" height="68" as="geometry" /></mxCell>
        <mxCell id="emcp" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Le deuxième client : la passerelle MCP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;mêmes routes, même clé ; trois outils en lecture seule ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucun outil ne donne accès à /briefing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="710" y="460" width="634" height="68" as="geometry" /></mxCell>
