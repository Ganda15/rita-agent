        <mxCell id="e429" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;429 : quota atteint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;10 appels par minute,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;partagés avec /question ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;refus poli à l&amp;#x27;écran&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="848" y="306" width="236" height="100" as="geometry" /></mxCell>
