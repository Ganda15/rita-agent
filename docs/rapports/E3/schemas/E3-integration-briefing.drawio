        <mxCell id="t" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Preuves&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_frontend.py (72, statiques) · tests/test_smoke_ui.py (7, vrai navigateur, /briefing intercepté) · tests/test_health.py, test_api_donnees.py (l&amp;#x27;API) · evidence/C10/&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="1320" height="60" as="geometry" /></mxCell>
