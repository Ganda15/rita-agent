        <mxCell id="fmt" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;Le format&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;Markdown lisible sur GitHub ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;synthèse S33 à S36 en PDF ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;liste de contrôle d&amp;#x27;accessibilité&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="506" y="390" width="388" height="100" as="geometry" /></mxCell>
        <mxCell id="fmt-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="506" y="390" width="7" height="100" as="geometry" /></mxCell>
        <mxCell id="chg" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;Ce que ça change dans RITA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;S34 (17/08) : 3 cas adverses,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;le filtre d&amp;#x27;injection bloque 7 sur 10 ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;seuil 85 %, test en échec attendu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="150" width="388" height="100" as="geometry" /></mxCell>
        <mxCell id="chg-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="956" y="150" width="7" height="100" as="geometry" /></mxCell>
        <mxCell id="par" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;Le partage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;11/10 : note S41 sur Discord,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;canal #veille ; capture versée ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;aucune réponse au 31/10&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="270" width="388" height="100" as="geometry" /></mxCell>
        <mxCell id="par-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="956" y="270" width="7" height="100" as="geometry" /></mxCell>
        <mxCell id="lec" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#0B2A5B&quot;&gt;La leçon, S41 va dans ce sens&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;un détecteur peut réussir le test&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;sur lequel il a été réglé, et rater&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;presque tout sur un autre jeu&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="390" width="388" height="100" as="geometry" /></mxCell>
