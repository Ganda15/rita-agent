        <mxCell id="tri" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#9A3412&quot;&gt;Le tri&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;écartés : LinkedIn et X, blogs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;d&amp;#x27;éditeurs d&amp;#x27;outils de sécurité,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;agrégateurs générés par IA&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="270" width="388" height="100" as="geometry" /></mxCell>
