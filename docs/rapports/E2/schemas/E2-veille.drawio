        <mxCell id="lim" value="&lt;b&gt;&lt;font style=&quot;font-size:17.5px;color:#C62828&quot;&gt;Limites&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;7 relevés et 5 notes de S33 à S44, dont 3 en rattrapage ; rien depuis le 11/10 · aucun échange collectif documenté&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15.5px;color:#111827&quot;&gt;accessibilité des notes non consignée (cases non cochées en S41) · envoi au formateur le 03/11, sans réponse&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=15.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="1320" height="80" as="geometry" /></mxCell>
