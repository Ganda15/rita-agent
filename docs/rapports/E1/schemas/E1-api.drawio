        <mxCell id="ttl" value="RITA : servir le jeu de données, une API REST protégée par une clé" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#0B2A5B;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="1428" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E1, section 7 (C5) · routes et contrat lus dans le code à la génération · état au 27 octobre 2026" style="text;html=1;align=left;fontSize=15;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="36" y="66" width="1428" height="24" as="geometry" /></mxCell>
