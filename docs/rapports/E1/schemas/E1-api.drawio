        <mxCell id="t6" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="758" y="290" as="sourcePoint" /><mxPoint x="758" y="316" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t7" value="clé valide" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="758" y="466" as="sourcePoint" /><mxPoint x="758" y="512" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t8" value="lit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#15803D;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#15803D;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#15803D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="938" y="530" as="sourcePoint" /><mxPoint x="1072" y="215" as="targetPoint" /><Array as="points"><mxPoint x="1003" y="530" /><mxPoint x="1003" y="215" /></Array></mxGeometry></mxCell>
        <mxCell id="t9" value="décrit" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="938" y="560" as="sourcePoint" /><mxPoint x="1072" y="350" as="targetPoint" /><Array as="points"><mxPoint x="1035" y="560" /><mxPoint x="1035" y="350" /></Array></mxGeometry></mxCell>
        <mxCell id="t10" value="vérifie" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1072" y="640" as="sourcePoint" /><mxPoint x="938" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="t11" value="réponse JSON aux clients" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="578" y="668" as="sourcePoint" /><mxPoint x="243" y="588" as="targetPoint" /><Array as="points"><mxPoint x="243" y="668" /></Array></mxGeometry></mxCell>
        <mxCell id="leg-t" value="Légende" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#0B2A5B;" vertex="1" parent="1"><mxGeometry x="36" y="808" width="80" height="24" as="geometry" /></mxCell>
