        <mxCell id="zc-bandeau" value="1. LES CLIENTS DU JEU DE DONNÉES" style="rounded=1;arcSize=18;html=1;fillColor=#0B2A5B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="112" width="430" height="34" as="geometry" /></mxCell>
        <mxCell id="za" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="566" y="104" width="384" height="590" as="geometry" /></mxCell>
        <mxCell id="za-bandeau" value="2. L&#x27;API REST (FastAPI)" style="rounded=1;arcSize=18;html=1;fillColor=#1565C0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="574" y="112" width="368" height="34" as="geometry" /></mxCell>
        <mxCell id="zd" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1060" y="104" width="420" height="590" as="geometry" /></mxCell>
        <mxCell id="zd-bandeau" value="3. DONNÉES, CONTRAT ET PREUVES" style="rounded=1;arcSize=18;html=1;fillColor=#6D28D9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1068" y="112" width="404" height="34" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Interface web (frontend/)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;écrans : portefeuille, indicateurs, risque, fraîcheur,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  valeurs, fiche d&amp;#x27;un article cité&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;clé saisie à l&amp;#x27;écran, jamais écrite dans frontend/&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="422" height="100" as="geometry" /></mxCell>
        <mxCell id="web-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="8" height="100" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Passerelle MCP (passerelle_mcp/serveur.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;3 outils : rita_fraicheur, rita_portefeuille,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  rita_indicateurs ; trois lectures, avec la clé&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="276" width="422" height="100" as="geometry" /></mxCell>
        <mxCell id="mcp-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="276" width="8" height="100" as="geometry" /></mxCell>
        <mxCell id="dep" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Contrôle après livraison (deploy/deployer.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sans clé, GET /donnees/valeurs doit répondre 403,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  sinon le contrôle de la livraison échoue&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="392" width="422" height="90" as="geometry" /></mxCell>
        <mxCell id="dep-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="392" width="8" height="90" as="geometry" /></mxCell>
        <mxCell id="doc" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;curl et navigateur : /docs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;le contrat essayé à l&amp;#x27;écran (Swagger UI)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;la clé se colle une fois, dans « Authorize »&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="498" width="422" height="90" as="geometry" /></mxCell>
        <mxCell id="doc-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="498" width="8" height="90" as="geometry" /></mxCell>
        <mxCell id="main" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;api/main.py : la clé sur tout le routeur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;include_router(routeur_donnees,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  dependencies=[Depends(verify_api_key)])&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;une route ajoutée est protégée d&amp;#x27;office&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;X-Request-ID sur toute réponse, refus compris&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="main-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="8" height="130" as="geometry" /></mxCell>
        <mxCell id="cle" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#9A3412&quot;&gt;Contrôle d&amp;#x27;accès : verify_api_key&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;en-tête X-API-Key, comparé par compare_digest&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;absente ou fausse : 403, une ligne de journal,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  jamais la clé, ni un morceau&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;clé d&amp;#x27;au moins 16 caractères, sans défaut&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="316" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="cle-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="316" width="8" height="150" as="geometry" /></mxCell>
        <mxCell id="routes" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;api/donnees.py : 12 points de terminaison&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;/valeurs · /cotations · /macro · /portefeuille&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;/mouvements · /volumes-anormaux · /indicateurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;/indicateurs-portefeuille · /indicateurs-risque&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;/articles · /articles/{article_id} · /fraicheur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;limite plafonnée par route, 1 000 au plus ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  /cotations se lit par pages, avec jusqu_a&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;422 saisie invalide, 404 ticker ou article inconnu&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="512" width="360" height="172" as="geometry" /></mxCell>
        <mxCell id="routes-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="512" width="8" height="172" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;PostgreSQL 18 : /donnees lit les données&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/database.py : les requêtes de db/requetes.sql&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;indicateurs/ : calculs déterministes, sans modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;appel de la passerelle MCP : une ligne d&amp;#x27;audit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  (mcp_calls), écrite après la réponse&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="396" height="120" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="8" height="120" as="geometry" /></mxCell>
        <mxCell id="contrat" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;Contrat OpenAPI 3.1.0, généré par FastAPI&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;19 chemins, dont 12 sous /donnees&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;schéma de sécurité APIKeyHeader déclaré&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;/openapi.json et /docs, tenus à jour par le code&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="300" width="396" height="100" as="geometry" /></mxCell>
        <mxCell id="contrat-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="300" width="8" height="100" as="geometry" /></mxCell>
        <mxCell id="tests" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Les preuves : tests/test_api_donnees.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;39 fonctions de test, dont :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;chaque route de /donnees, sans clé : 403&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2 600 séances fictives, pages de 1 000 (SQLite&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  en mémoire) : ni trou ni doublon&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="560" width="396" height="120" as="geometry" /></mxCell>
        <mxCell id="tests-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="560" width="8" height="120" as="geometry" /></mxCell>
        <mxCell id="cov" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#14532D&quot;&gt;Couverture de C5 : points de terminaison documentés ✓ · authentification documentée ✓ · standard OpenAPI ✓ · accès restreint ✓ · données nécessaires récupérables ✓&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Limites : une seule clé partagée, sans droits par utilisateur (décision D10) ; pas de quota sur /donnees (seulement /briefing et /question, qui appellent le modèle) ; taux de change sans route propre, ils servent à convertir le portefeuille.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="712" width="1460" height="66" as="geometry" /></mxCell>
        <mxCell id="cov-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="712" width="8" height="66" as="geometry" /></mxCell>
