        <mxCell id="csv" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;FICHIER · export courtier (CSV des positions)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/positions.py · « ; », cp1252, nombres à la française&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;démonstration : positions inventées, CSV versionné&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="616" width="422" height="76" as="geometry" /></mxCell>
