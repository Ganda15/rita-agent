        <mxCell id="bce" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;SERVICE WEB · Banque centrale européenne&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/ecb.py · taux de change contre l&amp;#x27;euro :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;USD, GBP, CHF, JPY ; zéro taux reçu = étape en échec&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="134" width="438" height="66" as="geometry" /></mxCell>
