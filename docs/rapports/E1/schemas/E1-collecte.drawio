        <mxCell id="pgl" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;BASE DE DONNÉES · PostgreSQL relu&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/database.py, indicateurs/ · requêtes paramétrées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;scout : DATABASE_URL ; rita_lecture : outils, pré-test&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="812" width="422" height="76" as="geometry" /></mxCell>
        <mxCell id="pgl-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="812" width="8" height="76" as="geometry" /></mxCell>
        <mxCell id="ing" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;pipelines/ingest.py : la collecte du soir&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;tâche planifiée Windows, chaque soir à 19 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;6 étapes : ecb, fred, cotations, rss, scraping, indexation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;une étape en échec n&amp;#x27;arrête pas les suivantes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;un COMMIT par étape ; rien reçu sur panne = échec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;manifeste JSON par exécution (versions, comptages)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;du 03 au 23/10 : 21 soirs sur 21, 19 à six étapes sur six&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="360" height="232" as="geometry" /></mxCell>
        <mxCell id="ing-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="8" height="232" as="geometry" /></mxCell>
        <mxCell id="gf" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#9A3412&quot;&gt;Garde-fou d&amp;#x27;injection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#9A3412&quot;&gt;(guardrails/injection.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;12 motifs : articles RSS, et textes de la page&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;scrapée (nom, ISIN, place : sources/scraper.py)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;mesure : 70 % de blocage (7/10),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;0 % de faux positifs (0/8)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;article bloqué : marqué, conservé pour l&amp;#x27;audit&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="416" width="360" height="172" as="geometry" /></mxCell>
        <mxCell id="gf-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="416" width="8" height="172" as="geometry" /></mxCell>
        <mxCell id="imp" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;db/importer.py : l&amp;#x27;import&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;archive Parquet : dédoublonnage (ticker, date),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  alias de portefeuille résolus (voir C3)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;positions : réconciliation ; une ligne retirée&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  du fichier est close à la date du jour,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  jamais supprimée&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="616" width="360" height="164" as="geometry" /></mxCell>
        <mxCell id="imp-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="616" width="8" height="164" as="geometry" /></mxCell>
        <mxCell id="lect" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Lecture, sans écriture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;le scout lit la base pour chaque briefing ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Spark lit le Parquet sans passer par la base&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="812" width="360" height="76" as="geometry" /></mxCell>
        <mxCell id="lect-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="812" width="8" height="76" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;Index ChromaDB (étape indexation)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;articles non bloqués, vectorisés pour la recherche&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;reconstruit après chaque collecte&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="396" height="96" as="geometry" /></mxCell>
        <mxCell id="chroma-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="8" height="96" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;PostgreSQL 18 (Merise, C4)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;10 tables, 1 vue, 12 contraintes CHECK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;écrit par la collecte et l&amp;#x27;import, seulement&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;278 473 cotations (29/07/2016 au 02/10/2026)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2 314 articles indexés (23/10) ; séries FRED&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;servi par l&amp;#x27;API /donnees/* (C5)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="280" width="396" height="200" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="280" width="8" height="200" as="geometry" /></mxCell>
        <mxCell id="rgpd" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;RGPD (registre art. 30, db/rgpd_purge.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;traitements T1 à T8, procédures de tri P1 à P6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;personnel : positions réelles, journal MCP, noms du corpus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;fichier réel hors de Git, jamais envoyé au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;purge en simulation par défaut ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;lancement manuel, écrit comme tel&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="616" width="396" height="164" as="geometry" /></mxCell>
        <mxCell id="rgpd-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="616" width="8" height="164" as="geometry" /></mxCell>
        <mxCell id="cov" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#14532D&quot;&gt;Couverture de C1 : service web ✓ · page web ✓ · fichier ✓ · base de données ✓ · système big data ✓&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Cinq types sur cinq, plus le RSS en complément. Une preuve par source dans evidence/C1/ ; la figure du 11/08 qui s&amp;#x27;y trouve est une preuve datée : ses chiffres de tables et de garde-fou ne sont plus à jour.&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="924" width="1460" height="66" as="geometry" /></mxCell>
