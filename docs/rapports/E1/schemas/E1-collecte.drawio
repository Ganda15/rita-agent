        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="fred" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="yahoo" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="scrap" target="gf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="rss" target="gf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="csv" target="imp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="parq" target="imp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="écrit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="ing" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="articles admis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="gf" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="insère" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="imp" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="ing" target="chroma"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="positions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;dashed=1;" edge="1" parent="1" source="imp" target="rgpd"><mxGeometry relative="1" as="geometry" /></mxCell>
