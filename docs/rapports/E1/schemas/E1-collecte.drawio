        <mxCell id="leg" value="Bleu clair : code qui écrit en base. Gris : réserves de données. Blanc : source ou lecture. Génération : docs/rapports/E1/schemas/generer_schemas.py, vérifiée par tests/test_schemas_e1.py." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1420" height="20" as="geometry" /></mxCell>
