        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1420" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : la collecte multi-source, cinq types de sources sur cinq" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1400" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E1, section 3 (C1) · chiffres du code lus à la génération, comptages datés · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1400" height="16" as="geometry" /></mxCell>
        <mxCell id="zs" value="&lt;b&gt;1. SOURCES, PAR TYPE EXIGÉ PAR C1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="470" height="640" as="geometry" /></mxCell>
        <mxCell id="bce" value="&lt;b&gt;SERVICE WEB · Banque centrale européenne&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/ecb.py · taux de change contre l&amp;#x27;euro :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;USD, GBP, CHF, JPY ; zéro taux reçu = étape en échec&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="118" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="fred" value="&lt;b&gt;SERVICE WEB · FRED (Réserve fédérale)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/fred.py · 3 séries macro américaines&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;seule source à clé, jamais écrite dans un journal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="186" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="yahoo" value="&lt;b&gt;SERVICE WEB · Yahoo Finance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/cotations.py · 111 valeurs, incrémental&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;rejouable (ON CONFLICT DO UPDATE)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="254" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="scrap" value="&lt;b&gt;PAGE WEB (scraping) · Boursorama&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/scraper.py · robots.txt lu et mis en cache&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;structure changée : exception StructurePageModifiee&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="322" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="rss" value="&lt;b&gt;COMPLÉMENT · flux RSS d&amp;#x27;actualité&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/rss.py · 3 flux généraux + 1 flux Google News&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;par valeur détenue (10 flux le 03/10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="390" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="csv" value="&lt;b&gt;FICHIER · export courtier (CSV des positions)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/positions.py · « ; », cp1252, nombres à la française&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;seule donnée personnelle du projet&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="470" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="parq" value="&lt;b&gt;SYSTÈME BIG DATA · Parquet + Spark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;bigdata/ · dix ans de cotations, 11 partitions par année&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;276 168 lignes ; requêtes Spark SQL (C2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="538" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="pgl" value="&lt;b&gt;BASE DE DONNÉES · PostgreSQL relu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/database.py · requêtes paramétrées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;lue par le nœud scout ; rôle rita_lecture (SELECT seul)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="626" width="438" height="58" as="geometry" /></mxCell>
        <mxCell id="zo" value="&lt;b&gt;2. TRAITEMENTS&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="420" height="640" as="geometry" /></mxCell>
        <mxCell id="ing" value="&lt;b&gt;pipelines/ingest.py : la collecte du soir&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;tâche planifiée Windows, chaque soir à 19 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;6 étapes : ecb, fred, cotations, rss, scraping, indexation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une étape en échec n&amp;#x27;arrête pas les suivantes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;un COMMIT par étape ; zéro ligne reçue = échec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;manifeste JSON par exécution (versions, comptages)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;40 journaux du 24/08 au 02/10, 33 à code 0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="118" width="388" height="150" as="geometry" /></mxCell>
        <mxCell id="gf" value="&lt;b&gt;Garde-fou d&amp;#x27;injection (guardrails/injection.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;12 motifs, appliqué aux articles RSS et scrapés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;mesure du jour : 70 % de blocage, 0 % de faux positifs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;article bloqué : marqué, conservé pour l&amp;#x27;audit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="284" width="388" height="86" as="geometry" /></mxCell>
        <mxCell id="imp" value="&lt;b&gt;db/importer.py : l&amp;#x27;import&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;archive Parquet : dédoublonnage (ticker, date),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  alias de portefeuille résolus (voir C3)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;positions : réconciliation ; une ligne retirée&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  du fichier est close à la date du jour,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  jamais supprimée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="470" width="388" height="126" as="geometry" /></mxCell>
        <mxCell id="lect" value="&lt;b&gt;Lecture, sans écriture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;le scout lit la base pour chaque briefing ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;Spark lit le Parquet sans passer par la base&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="626" width="388" height="58" as="geometry" /></mxCell>
        <mxCell id="zd" value="&lt;b&gt;3. DESTINATION ET CONFORMITÉ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1030" y="90" width="430" height="640" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 18 (Merise, C4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;10 tables, 1 vue, 12 contraintes CHECK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;écrit par la collecte et l&amp;#x27;import, seulement&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;278 457 cotations (29/07/2016 au 02/10/2026)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;1 563 articles ; séries FRED stockées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;servi par l&amp;#x27;API /donnees/* (C5)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="118" width="398" height="120" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;Index ChromaDB (étape indexation)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;articles vectorisés pour la recherche documentaire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;reconstruit après chaque collecte&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="254" width="398" height="58" as="geometry" /></mxCell>
        <mxCell id="rgpd" value="&lt;b&gt;RGPD (registre art. 30, db/rgpd_purge.py)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;traitements T1 à T5, procédures de tri P1 à P6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;une seule table personnelle : position&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;fichier source hors de Git, jamais envoyé au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;purge en simulation par défaut ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;lancement manuel, écrit comme tel&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="470" width="398" height="126" as="geometry" /></mxCell>
        <mxCell id="cov" value="&lt;b&gt;Couverture de C1 : service web ✓ · page web ✓ · fichier ✓ · base de données ✓ · système big data ✓&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;Cinq types sur cinq, plus le RSS en complément. Une preuve par source dans evidence/C1/ ; la figure du 11/08 qui s&amp;#x27;y trouve est une preuve datée : ses chiffres de tables et de garde-fou ne sont plus à jour.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1420" height="56" as="geometry" /></mxCell>
