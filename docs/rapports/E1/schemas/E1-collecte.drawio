        <mxCell id="rss" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;COMPLÉMENT · flux RSS d&amp;#x27;actualité&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/rss.py · 3 flux de presse générale ; Google News&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;par valeur détenue arrêté le 16/10 (décision D3)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="512" width="422" height="76" as="geometry" /></mxCell>
