        <mxCell id="fred" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;SERVICE WEB · FRED (Réserve fédérale)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/fred.py · 3 séries macro américaines&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;seule source à clé, jamais écrite dans un journal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="210" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="fred-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="210" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="yahoo" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;SERVICE WEB · Yahoo Finance&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/cotations.py · 111 valeurs, incrémental&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;rejouable (ON CONFLICT DO UPDATE)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="286" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="yahoo-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="286" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="scrap" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;PAGE WEB (scraping) · Boursorama&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/scraper.py · robots.txt lu et mis en cache&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;structure changée : exception StructurePageModifiee&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="362" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="scrap-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="362" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="rss" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;COMPLÉMENT · flux RSS d&amp;#x27;actualité&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/rss.py · 3 flux généraux + 1 flux Google News&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;par valeur détenue (10 flux le 03/10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="438" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="rss-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="438" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="csv" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;FICHIER · export courtier (CSV des positions)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/positions.py · « ; », cp1252, nombres à la française&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;seule donnée personnelle du projet&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="524" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="csv-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="524" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="parq" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;SYSTÈME BIG DATA · Parquet + Spark&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;bigdata/ · dix ans de cotations, 11 partitions par année&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;276 168 lignes ; requêtes Spark SQL (C2)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="600" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="parq-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="600" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="pgl" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;BASE DE DONNÉES · PostgreSQL relu&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/database.py · requêtes paramétrées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;lue par le nœud scout ; rôle rita_lecture (SELECT seul)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="686" width="438" height="66" as="geometry" /></mxCell>
        <mxCell id="pgl-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="686" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="ing" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;pipelines/ingest.py : la collecte du soir&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tâche planifiée Windows, chaque soir à 19 h&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;6 étapes : ecb, fred, cotations, rss, scraping, indexation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;une étape en échec n&amp;#x27;arrête pas les suivantes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;un COMMIT par étape ; zéro ligne reçue = échec&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;manifeste JSON par exécution (versions, comptages)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;40 journaux du 24/08 au 02/10, 33 à code 0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="134" width="388" height="150" as="geometry" /></mxCell>
        <mxCell id="ing-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="134" width="7" height="150" as="geometry" /></mxCell>
        <mxCell id="gf" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;Garde-fou d&amp;#x27;injection (guardrails/injection.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;12 motifs : articles RSS, et textes de la page&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;scrapée (nom, ISIN, place : sources/scraper.py)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;mesure du jour : 70 % de blocage, 0 % de faux positifs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;article bloqué : marqué, conservé pour l&amp;#x27;audit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="306" width="388" height="100" as="geometry" /></mxCell>
        <mxCell id="gf-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="306" width="7" height="100" as="geometry" /></mxCell>
        <mxCell id="imp" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;db/importer.py : l&amp;#x27;import&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;archive Parquet : dédoublonnage (ticker, date),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  alias de portefeuille résolus (voir C3)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;positions : réconciliation ; une ligne retirée&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  du fichier est close à la date du jour,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  jamais supprimée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="524" width="388" height="142" as="geometry" /></mxCell>
        <mxCell id="imp-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="524" width="7" height="142" as="geometry" /></mxCell>
        <mxCell id="lect" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Lecture, sans écriture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le scout lit la base pour chaque briefing ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;Spark lit le Parquet sans passer par la base&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="686" width="388" height="66" as="geometry" /></mxCell>
        <mxCell id="lect-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="686" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;PostgreSQL 18 (Merise, C4)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;10 tables, 1 vue, 12 contraintes CHECK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;écrit par la collecte et l&amp;#x27;import, seulement&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;278 473 cotations (29/07/2016 au 02/10/2026)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;1 563 articles ; séries FRED stockées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;servi par l&amp;#x27;API /donnees/* (C5)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="134" width="398" height="120" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="134" width="7" height="120" as="geometry" /></mxCell>
        <mxCell id="chroma" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;Index ChromaDB (étape indexation)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;articles vectorisés pour la recherche documentaire&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reconstruit après chaque collecte&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="270" width="398" height="66" as="geometry" /></mxCell>
        <mxCell id="chroma-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="270" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="rgpd" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;RGPD (registre art. 30, db/rgpd_purge.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;traitements T1 à T5, procédures de tri P1 à P6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;une seule table personnelle : position&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;fichier source hors de Git, jamais envoyé au modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;purge en simulation par défaut ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;lancement manuel, écrit comme tel&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1046" y="524" width="398" height="142" as="geometry" /></mxCell>
        <mxCell id="rgpd-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1046" y="524" width="7" height="142" as="geometry" /></mxCell>
        <mxCell id="cov" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Couverture de C1 : service web ✓ · page web ✓ · fichier ✓ · base de données ✓ · système big data ✓&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;Cinq types sur cinq, plus le RSS en complément. Une preuve par source dans evidence/C1/ ; la figure du 11/08 qui s&amp;#x27;y trouve est une preuve datée : ses chiffres de tables et de garde-fou ne sont plus à jour.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="1420" height="66" as="geometry" /></mxCell>
