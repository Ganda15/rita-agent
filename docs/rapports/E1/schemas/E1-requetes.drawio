        <mxCell id="zd" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1060" y="104" width="420" height="584" as="geometry" /></mxCell>
        <mxCell id="zd-bandeau" value="3. LE COÛT, MESURÉ" style="rounded=1;arcSize=18;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1068" y="112" width="404" height="34" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;SGBD · PostgreSQL 18 (Merise, C4)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;10 tables, 278 473 cotations au 02/10/2026&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;clé primaire (ticker, date_seance), index sur la date&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/database.py : les requêtes de db/requetes.sql,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  valeurs passées par %(nom)s, jamais concaténées&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="422" height="130" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="160" width="8" height="130" as="geometry" /></mxCell>
        <mxCell id="parq" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;SYSTÈME BIG DATA · Parquet + Spark&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;data/bigdata/ohlcv/annee=AAAA/ : 11 partitions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;276 168 lignes, 111 valeurs, 14 Mo (comptés le 27/10)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;du 29/07/2016 au 29/07/2026, écrit par build_parquet.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Spark en local[*], 8 partitions de shuffle (et non 200)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="358" width="422" height="130" as="geometry" /></mxCell>
        <mxCell id="parq-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="358" width="8" height="130" as="geometry" /></mxCell>
        <mxCell id="part" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Lignes par partition (comptées le 27/10)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2016 : 11 980 · 2017 : 27 770 · 2018 : 27 610&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2019 : 27 463 · 2020 : 27 488 · 2021 : 27 589&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2022 : 27 480 · 2023 : 27 454 · 2024 : 27 648&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2025 : 27 783 · 2026 : 15 903&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2016 et 2026 incomplètes : dix ans depuis le 29/07/2016&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="32" y="538" width="422" height="130" as="geometry" /></mxCell>
        <mxCell id="part-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="538" width="8" height="130" as="geometry" /></mxCell>
        <mxCell id="sql" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;db/requetes.sql : le SQL de PostgreSQL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;R1 portefeuille en euros : LEFT JOIN LATERAL,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  dernier cours de chaque valeur, dernier taux&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;R1 bis positions closes, pour le propriétaire seul&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;R2 plus fortes variations : LAG() par valeur,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  filtre de date avant la fenêtre, statut OK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;R3 volumes anormaux : moyenne des 20 séances&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  précédentes, sur les 60 derniers jours&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="360" height="178" as="geometry" /></mxCell>
        <mxCell id="sql-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="160" width="8" height="178" as="geometry" /></mxCell>
        <mxCell id="spark" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;bigdata/query_spark.py : Spark SQL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S1 volumétrie : GROUP BY annee, sans filtre&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S2 amplitude moyenne : WHERE annee &amp;gt;= 2024,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  HAVING COUNT(*) &amp;gt;= 200 séances&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S3 meilleure séance : WHERE annee &amp;gt;= 2025,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  LAG() puis RANK() OVER (PARTITION BY ticker)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;le même vocabulaire que PostgreSQL, un autre moteur&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="358" width="360" height="160" as="geometry" /></mxCell>
        <mxCell id="spark-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="358" width="8" height="160" as="geometry" /></mxCell>
        <mxCell id="choix" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Les choix, écrits devant chaque requête&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;OBJECTIF, CHOIX (sélection, jointure, filtre),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;OPTIMISATION, dans les deux fichiers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sorties réelles : evidence/C2/preuve-requetes-sql.md&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="578" y="538" width="360" height="100" as="geometry" /></mxCell>
        <mxCell id="choix-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="578" y="538" width="8" height="100" as="geometry" /></mxCell>
        <mxCell id="expl" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;PostgreSQL : EXPLAIN ANALYZE (août 2026)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;dernier cours des 111 valeurs :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  DISTINCT ON 295,19 ms, LATERAL 1,19 ms&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;les 7 positions : CTE DISTINCT ON 258,00 ms,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  sous-requête corrélée 0,12 ms, LATERAL 0,24 ms&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;DISTINCT ON triait les 273 608 cotations ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  LATERAL va chercher par l&amp;#x27;index (cotation_pkey)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;l&amp;#x27;optimisation prévue était la mauvaise&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="396" height="178" as="geometry" /></mxCell>
        <mxCell id="expl-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="160" width="8" height="178" as="geometry" /></mxCell>
        <mxCell id="plan" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Spark : partitions lues (comptées le 27/10)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S1 lit 11/11 partitions : 276 168 lignes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S2 lit 3/11 : 71 334 lignes, 8 partitions écartées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;S3 lit 2/11 : 43 686 lignes, 9 partitions écartées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;preuve dans le plan, pour annee = 2024 :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  PartitionFilters: [isnotnull(annee), (annee = 2024)]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  1 partition lue sur 11, 27 648 lignes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;coût qui reste : le shuffle (GROUP BY, PARTITION BY)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="358" width="396" height="160" as="geometry" /></mxCell>
        <mxCell id="plan-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="358" width="8" height="160" as="geometry" /></mxCell>
        <mxCell id="cmp" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Optimiser ne veut pas dire la même chose&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;PostgreSQL : choisir le bon chemin d&amp;#x27;accès, l&amp;#x27;index&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Spark : ne pas lire les partitions inutiles&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;ce qui coûte : trier toute la table / le shuffle&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1072" y="538" width="396" height="100" as="geometry" /></mxCell>
        <mxCell id="cmp-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1072" y="538" width="8" height="100" as="geometry" /></mxCell>
        <mxCell id="cov" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#14532D&quot;&gt;Couverture de C2 : requêtes fonctionnelles ✓ · choix documentés ✓ · optimisations expliquées ✓&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;SGBD et système big data, chacun dans son langage. Limite : 276 168 lignes et 14 Mo ne sont pas du big data ; la méthode est montrée en local (cadrage accepté par le formateur en août).&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="1460" height="66" as="geometry" /></mxCell>
        <mxCell id="cov-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="8" height="66" as="geometry" /></mxCell>
