        <mxCell id="leg-bt-stock" value="système de données" style="text;html=1;align=left;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="798" width="118" height="24" as="geometry" /></mxCell>
