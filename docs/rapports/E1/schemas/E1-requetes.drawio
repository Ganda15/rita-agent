        <mxCell id="t2" value="mesuré" style="edgeStyle=none;rounded=0;html=1;strokeColor=#0B2A5B;strokeWidth=2.6;endArrow=block;endFill=1;fontColor=#0B2A5B;fontStyle=1;fontSize=12;labelBackgroundColor=#FFFFFF;labelBorderColor=#0B2A5B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="938" y="249" as="sourcePoint" /><mxPoint x="1072" y="249" as="targetPoint" /></mxGeometry></mxCell>
