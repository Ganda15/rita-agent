        <mxCell id="d3" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Cours maximal 7 156 748 (ALJXR.PA)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;regroupement d&amp;#x27;actions rétro-ajusté (prix ÷ 36 millions)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="456" height="92" as="geometry" /></mxCell>
