        <mxCell id="f1-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="274" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;1 533 clôtures hors de [bas, haut], dont 1 142 STLAP.PA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sans règle : des variations aberrantes au briefing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="350" width="440" height="66" as="geometry" /></mxCell>
        <mxCell id="d2-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="350" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="r2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;STLAP.PA marquée INCOHERENT : exclue des requêtes, gardée&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucune contrainte ne borne la clôture (db/schema.sql refuse haut &amp;lt; bas) :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;23 lignes hors bornes en base le 04/10, limite déclarée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="350" width="520" height="66" as="geometry" /></mxCell>
