        <mxCell id="f2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;db/importer.py (QUALITE), sources/database.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;les requêtes ne lisent que statut_qualite = &amp;#x27;OK&amp;#x27;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="350" width="380" height="66" as="geometry" /></mxCell>
        <mxCell id="f2-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="350" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Cours maximal 7 156 748 (ALJXR.PA)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;regroupement d&amp;#x27;actions rétro-ajusté (prix ÷ 36 millions)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="426" width="440" height="66" as="geometry" /></mxCell>
        <mxCell id="d3-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="426" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="r3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;Marquée INCOHERENT, conservée, mécanisme identifié&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;la table operation_sur_titre est conçue, pas construite&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="426" width="520" height="66" as="geometry" /></mxCell>
        <mxCell id="r3-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="426" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;evidence/C3/preuve-artefact-reverse-split.md&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;statut_qualite : exclure sans supprimer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="426" width="380" height="66" as="geometry" /></mxCell>
        <mxCell id="f3-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="426" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Libellés du portefeuille différents des tickers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;« CGG BS », « CGG RGPT » : aucune position rattachée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="502" width="440" height="66" as="geometry" /></mxCell>
        <mxCell id="d4-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="502" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Entité ALIAS au modèle : une valeur, plusieurs noms&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;112 alias pour 111 valeurs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="502" width="520" height="66" as="geometry" /></mxCell>
        <mxCell id="r4-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="502" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;db/importer.py, table alias_valeur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;cardinalité VALEUR 1,n / ALIAS 1,1 (Merise, C4)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="502" width="380" height="66" as="geometry" /></mxCell>
        <mxCell id="f4-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="502" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="d5" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;INC-005 (27/09) : 52 426 cotations un dimanche&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;date UTC d&amp;#x27;un « minuit à Paris » = la veille à 22 h ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;même cause : pence de Londres, dollars, samedi, fériés&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="578" width="440" height="66" as="geometry" /></mxCell>
        <mxCell id="d5-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="578" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="r5" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;La place de cotation entre dans le modèle&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;fuseau, devise et unité de prix par place, fériés Euronext ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;correctif en une transaction, 42 tests écrits d&amp;#x27;abord&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="578" width="520" height="66" as="geometry" /></mxCell>
        <mxCell id="r5-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="578" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;sources/marches.py, sources/cotations.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;leçon : compter aussi par jour de la semaine&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="578" width="380" height="66" as="geometry" /></mxCell>
        <mxCell id="f5-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1064" y="578" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="pos" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Le fichier des positions (export courtier)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sources/positions.py : séparateur « ; », encodage cp1252 détecté,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;« 632,40 » et « 1 250 » (espace insécable) convertis, en-têtes variables ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;chaque ligne invalide est rejetée avec sa cause, jamais ignorée en silence&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="700" height="96" as="geometry" /></mxCell>
        <mxCell id="pos-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="7" height="96" as="geometry" /></mxCell>
        <mxCell id="vol" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Ce qui reste visible plutôt que corrigé&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;2 802 séances à volume nul conservées : la requête des volumes anormaux&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  (R3, db/requetes.sql) exige une moyenne sur 20 séances &amp;gt; 0, sinon division par zéro ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;les valeurs douteuses portent un statut_qualite au lieu d&amp;#x27;être supprimées&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="676" width="700" height="96" as="geometry" /></mxCell>
