        <mxCell id="pos" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Le fichier des positions (export courtier)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sources/positions.py : séparateur « ; », encodage cp1252 détecté,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;« 632,40 » et « 1 250 » (espace insécable) convertis, en-têtes variables ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;chaque ligne invalide est rejetée avec sa cause, jamais ignorée en silence&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="834" width="700" height="110" as="geometry" /></mxCell>
        <mxCell id="pos-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="834" width="8" height="110" as="geometry" /></mxCell>
        <mxCell id="vol" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Ce qui reste visible plutôt que corrigé&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;2 802 séances à volume nul conservées : la requête des volumes anormaux&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;  (R3, db/requetes.sql) exige une moyenne sur 20 séances &amp;gt; 0, sinon division par zéro ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;les valeurs douteuses portent un statut_qualite au lieu d&amp;#x27;être supprimées&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="760" y="834" width="700" height="110" as="geometry" /></mxCell>
