        <mxCell id="f3" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;evidence/C3/preuve-artefact-reverse-split.md&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;statut_qualite : écartée des classements, gardée&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1084" y="504" width="376" height="92" as="geometry" /></mxCell>
        <mxCell id="f3-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1084" y="504" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Libellés du portefeuille différents des tickers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;« CGG BS », « CGG RGPT » : aucune position rattachée&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="456" height="92" as="geometry" /></mxCell>
        <mxCell id="d4-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#C62828&quot;&gt;Entité ALIAS au modèle : une valeur, plusieurs noms&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;112 alias pour 111 valeurs ; deux libellés, un ticker :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;pas la preuve d&amp;#x27;un même instrument (addendum du 26/10) ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;une position « CGG BS » serait valorisée au cours de l&amp;#x27;action&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="532" y="606" width="516" height="92" as="geometry" /></mxCell>
        <mxCell id="r4-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="532" y="606" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;db/importer.py, table alias_valeur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;cardinalité VALEUR 1,n / ALIAS 1,1 (Merise, C4)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1084" y="606" width="376" height="92" as="geometry" /></mxCell>
        <mxCell id="f4-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1084" y="606" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="d5" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;INC-005 (27/09) : 52 426 cotations un dimanche&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;date UTC d&amp;#x27;un « minuit à Paris » = la veille à 22 h ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;même racine, la place de cotation non modélisée :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;pence de Londres, dollars, samedi, fériés&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="456" height="92" as="geometry" /></mxCell>
        <mxCell id="d5-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="r5" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;La place de cotation entre dans le modèle&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;fuseau, devise et unité de prix par place, fériés Euronext ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;correctif en une transaction, 42 tests écrits d&amp;#x27;abord&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="532" y="708" width="516" height="92" as="geometry" /></mxCell>
        <mxCell id="r5-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="532" y="708" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;sources/marches.py, sources/cotations.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;leçon : compter aussi par jour de la semaine&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1084" y="708" width="376" height="92" as="geometry" /></mxCell>
