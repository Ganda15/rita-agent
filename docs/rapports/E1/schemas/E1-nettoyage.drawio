        <mxCell id="zf-bandeau" value="FICHIER QUI L&#x27;APPLIQUE" style="rounded=1;arcSize=18;html=1;fillColor=#475569;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1080" y="256" width="384" height="34" as="geometry" /></mxCell>
        <mxCell id="brut" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#4C1D95&quot;&gt;1. Le jeu brut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;dix ans de cotations, 111 valeurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;Parquet, 11 partitions, une par année&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;276 168 lignes analysées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;0 valeur manquante&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="104" width="300" height="124" as="geometry" /></mxCell>
