        <mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;5 120 lignes en double (2 560 paires), surtout VIRI.PA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;sans règle : l&amp;#x27;import échoue sur la clé primaire&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="456" height="92" as="geometry" /></mxCell>
        <mxCell id="d1-bande" value="" style="rounded=1;arcSize=30;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="8" height="92" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#0B2A5B&quot;&gt;Dédoublonnage sur (ticker, date), avant insertion&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;la date de l&amp;#x27;archive, avant le calcul de date_seance ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;la collecte du soir, elle, rejoue : ON CONFLICT DO UPDATE&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="532" y="300" width="516" height="92" as="geometry" /></mxCell>
