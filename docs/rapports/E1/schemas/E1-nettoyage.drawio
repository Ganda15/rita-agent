<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="RITA" version="24.0.0" type="device">
  <diagram id="E1-nettoyage" name="RITA : nettoyer et agréger, chaque défaut mesuré devient une règle">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="topline" value="" style="line;strokeWidth=2.5;html=1;strokeColor=#14607F;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1420" height="10" as="geometry" /></mxCell>
        <mxCell id="ttl" value="RITA : nettoyer et agréger, chaque défaut mesuré devient une règle" style="text;html=1;align=left;fontSize=17;fontStyle=1;fontColor=#16202B;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1400" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="Rapport E1, section 4 (C3) · analyse exploratoire de juillet 2026, incident INC-005 du 27 septembre · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=10.5;fontStyle=2;fontColor=#4A5766;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1400" height="16" as="geometry" /></mxCell>
        <mxCell id="brut" value="&lt;b&gt;1. Le jeu brut&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;dix ans de cotations, 111 valeurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;Parquet, 11 partitions par année&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;276 168 lignes analysées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;0 valeur manquante&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="104" as="geometry" /></mxCell>
        <mxCell id="eda" value="&lt;b&gt;2. Analyse exploratoire (juillet)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;compter avant de modéliser :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;doublons, bornes, volumes, extrêmes,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;libellés ; preuves dans evidence/C3/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;chaque défaut → une décision de schéma&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="330" height="104" as="geometry" /></mxCell>
        <mxCell id="agr" value="&lt;b&gt;3. Agrégation en un seul jeu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;dates ISO 8601 dans le fuseau de la place&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;devises ISO 4217, nombres français convertis&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;codes ISIN complétés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;puis chargement par db/importer.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="750" y="100" width="330" height="104" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;4. Le jeu propre, en base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;276 168 lues → 2 560 doublons écartés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;→ 273 608 insérées (juillet 2026)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;→ 278 457 cotations au 02/10/2026&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;après 40 collectes du soir&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D8E3EA;strokeColor=none;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="340" height="104" as="geometry" /></mxCell>
        <mxCell id="zr" value="&lt;b&gt;DÉFAUT MESURÉ  →  DÉCISION  →  FICHIER QUI L&amp;#x27;APPLIQUE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D5DCE4;dashed=1;align=left;verticalAlign=top;fontSize=9;fontColor=#4A5766;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1420" height="400" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;5 120 lignes en double (2 560 paires), surtout VIRI.PA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sans règle : l&amp;#x27;import échoue sur la clé primaire&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="258" width="440" height="58" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;Dédoublonnage sur (ticker, date_seance) avant insertion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la collecte du soir est rejouable : ON CONFLICT DO UPDATE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="258" width="520" height="58" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;db/importer.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;preuve : evidence/C3/preuve-dedoublonnage-cgg.md&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="258" width="380" height="58" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;1 533 clôtures hors de [bas, haut], dont 1 142 STLAP.PA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sans règle : des variations aberrantes au briefing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="330" width="440" height="58" as="geometry" /></mxCell>
        <mxCell id="r2" value="&lt;b&gt;STLAP.PA marquée INCOHERENT : exclue des requêtes, gardée&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;aucune contrainte ne borne la clôture (db/schema.sql refuse haut &amp;lt; bas) :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;23 lignes hors bornes en base le 04/10, limite déclarée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="520" height="58" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;db/importer.py (QUALITE), sources/database.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;les requêtes ne lisent que statut_qualite = &amp;#x27;OK&amp;#x27;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="330" width="380" height="58" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Cours maximal 7 156 748 (ALJXR.PA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;regroupement d&amp;#x27;actions rétro-ajusté (prix ÷ 36 millions)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="402" width="440" height="58" as="geometry" /></mxCell>
        <mxCell id="r3" value="&lt;b&gt;Marquée INCOHERENT, conservée, mécanisme identifié&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;la table operation_sur_titre est conçue, pas construite&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF1EC;strokeColor=#9E4318;dashed=1;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="402" width="520" height="58" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;evidence/C3/preuve-artefact-reverse-split.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;statut_qualite : exclure sans supprimer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="402" width="380" height="58" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;Libellés du portefeuille différents des tickers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;« CGG BS », « CGG RGPT » : aucune position rattachée&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="474" width="440" height="58" as="geometry" /></mxCell>
        <mxCell id="r4" value="&lt;b&gt;Entité ALIAS au modèle : une valeur, plusieurs noms&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;112 alias pour 111 valeurs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="474" width="520" height="58" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;db/importer.py, table alias_valeur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;cardinalité VALEUR 1,n / ALIAS 1,1 (Merise, C4)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="474" width="380" height="58" as="geometry" /></mxCell>
        <mxCell id="d5" value="&lt;b&gt;INC-005 (27/09) : 52 426 cotations un dimanche&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;date UTC d&amp;#x27;un « minuit à Paris » = la veille à 22 h ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;même cause : pence de Londres, dollars, samedi, fériés&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="546" width="440" height="70" as="geometry" /></mxCell>
        <mxCell id="r5" value="&lt;b&gt;La place de cotation entre dans le modèle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;fuseau, devise et unité de prix par place, fériés Euronext ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;correctif en une transaction, 42 tests écrits d&amp;#x27;abord&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECF3F7;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="546" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;sources/marches.py, sources/cotations.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;leçon : compter aussi par jour de la semaine&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;spacingLeft=8;fontSize=8.5;fontColor=#4A5766;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1064" y="546" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="pos" value="&lt;b&gt;Le fichier des positions (export courtier)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;sources/positions.py : séparateur « ; », encodage cp1252 détecté,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;« 632,40 » et « 1 250 » (espace insécable) convertis, en-têtes variables ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;chaque ligne invalide est rejetée avec sa cause, jamais ignorée en silence&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="700" height="96" as="geometry" /></mxCell>
        <mxCell id="vol" value="&lt;b&gt;Ce qui reste visible plutôt que corrigé&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;2 802 séances à volume nul conservées : la requête des volumes anormaux&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;  (R3, db/requetes.sql) exige une moyenne sur 20 séances &amp;gt; 0, sinon division par zéro ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#4A5766&quot;&gt;les valeurs douteuses portent un statut_qualite au lieu d&amp;#x27;être supprimées&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14607F;align=left;spacingLeft=8;fontSize=9;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="760" y="650" width="700" height="96" as="geometry" /></mxCell>
        <mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="brut" target="eda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="eda" target="agr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="agr" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="d1" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="r1" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="d2" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="r2" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="d3" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="r3" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="d4" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="r4" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="d5" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5766;strokeWidth=1.3;endArrow=classic;" edge="1" parent="1" source="r5" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="Blanc : défaut mesuré. Bleu clair : décision appliquée. Pointillé orange : limite déclarée, ou décision conçue non construite. Gris : fichier ou preuve à ouvrir. Chiffres de juillet et du 02/10 : rapport E1, section 4." style="text;html=1;align=left;fontSize=9;fontColor=#4A5766;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1420" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
