        <mxCell id="r3" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#C62828&quot;&gt;Marquée INCOHERENT, conservée, mécanisme identifié&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;la table operation_sur_titre est conçue, pas construite&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="532" y="504" width="516" height="92" as="geometry" /></mxCell>
