        <mxCell id="r2" value="&lt;b&gt;&lt;font style=&quot;font-size:14.5px;color:#C62828&quot;&gt;STLAP.PA marquée INCOHERENT : exclue des classements, gardée&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;aucune contrainte ne borne la clôture (db/schema.sql refuse haut &amp;lt; bas) :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#111827&quot;&gt;23 lignes hors bornes en base le 04/10, limite déclarée&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=18;spacingTop=4;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="532" y="402" width="516" height="92" as="geometry" /></mxCell>
