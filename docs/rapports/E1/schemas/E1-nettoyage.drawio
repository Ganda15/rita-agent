        <mxCell id="sub" value="Rapport E1, section 4 (C3) · analyse exploratoire de juillet 2026, incident INC-005 du 27 septembre · état au 4 octobre 2026" style="text;html=1;align=left;fontSize=15;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1400" height="22" as="geometry" /></mxCell>
        <mxCell id="zr" value="DÉFAUT MESURÉ  →  DÉCISION  →  FICHIER QUI L&#x27;APPLIQUE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="1420" height="410" as="geometry" /></mxCell>
        <mxCell id="brut" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;1. Le jeu brut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;dix ans de cotations, 111 valeurs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;Parquet, 11 partitions par année&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;276 168 lignes analysées&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;0 valeur manquante&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="300" height="104" as="geometry" /></mxCell>
        <mxCell id="brut-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="7" height="104" as="geometry" /></mxCell>
        <mxCell id="eda" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;2. Analyse exploratoire (juillet)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;compter avant de modéliser :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;doublons, bornes, volumes, extrêmes,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;libellés ; preuves dans evidence/C3/&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;chaque défaut → une décision de schéma&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="380" y="116" width="330" height="104" as="geometry" /></mxCell>
        <mxCell id="eda-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="380" y="116" width="7" height="104" as="geometry" /></mxCell>
        <mxCell id="agr" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;3. Agrégation en un seul jeu&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;dates ISO 8601 dans le fuseau de la place&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;devises ISO 4217, nombres français convertis&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;codes ISIN complétés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;puis chargement par db/importer.py&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="750" y="116" width="330" height="104" as="geometry" /></mxCell>
        <mxCell id="agr-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="750" y="116" width="7" height="104" as="geometry" /></mxCell>
        <mxCell id="res" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;4. Le jeu propre, en base&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;276 168 lues → 2 560 doublons écartés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;→ 273 608 insérées (juillet 2026)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;→ 278 473 cotations au 02/10/2026&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;après 40 collectes du soir&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="116" width="340" height="104" as="geometry" /></mxCell>
        <mxCell id="res-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1120" y="116" width="7" height="104" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;5 120 lignes en double (2 560 paires), surtout VIRI.PA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sans règle : l&amp;#x27;import échoue sur la clé primaire&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="274" width="440" height="66" as="geometry" /></mxCell>
        <mxCell id="d1-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="274" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="r1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Dédoublonnage sur (ticker, date_seance) avant insertion&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;la collecte du soir est rejouable : ON CONFLICT DO UPDATE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="274" width="520" height="66" as="geometry" /></mxCell>
