        <mxCell id="sub" value="Chaque boîte : son fichier, sa fonction, sa ligne et ses tests · vert : codé au sprint 4 · orange : garde-fou déjà là · [S1] [S3] [S4] : le sprint où c&#x27;est codé" style="text;html=1;align=left;fontSize=15;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1900" height="22" as="geometry" /></mxCell>
        <mxCell id="z0" value="0 · LES ÉCRANS ET L&#x27;API : PAR OÙ TOUT ENTRE (frontend/, api/)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="1920" height="160" as="geometry" /></mxCell>
        <mxCell id="za" value="A · LES QUESTIONS (avenant n°1) : agents/question.py repondre l.237 orchestre tout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="900" height="980" as="geometry" /></mxCell>
        <mxCell id="zb" value="B · LE BRIEFING [S1] : graph/workflow.py (LangGraph)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="960" y="296" width="500" height="980" as="geometry" /></mxCell>
        <mxCell id="zc" value="C · TRACE SANS TEXTE, MESURE, PRODUCTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1480" y="296" width="480" height="980" as="geometry" /></mxCell>
        <mxCell id="e1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Écran des questions [S3]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;frontend/question.html, question.js&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;MOTIFS l.18 : le motif dit en mots [S4]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;afficherRefus l.180 : « Pas de réponse »&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé dans un champ masqué&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="e1-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="rq" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Route POST /question [S3]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;api/question.py : poser_question l.37&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;appelle agents/question.py repondre&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;journal « question servie » l.59&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 à 500 caractères&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="372" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="rq-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="372" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="k" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;Clé [S1], refus journalisé [S4]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;api/main.py : verify_api_key l.162&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;403 + ligne « cle d&amp;#x27;API refusee » l.178&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;jamais la clé, ni un morceau&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_refus_cle_journal.py (5)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="688" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="k-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="688" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="lim" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;Limite de débit [S4]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;api/limiteur.py : LIMITEUR l.58&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;limiter_debit l.61 : 10 appels/min,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;partagés par les deux routes ; 429&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_limiteur.py (7)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1004" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="lim-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1004" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="rb" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;Route POST /briefing [S1], 422 [S4]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;api/main.py : briefing l.245&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;valeur_existe l.257 (indicateurs/socle.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;l.150) : inconnue → 422, sans modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_briefing_422.py (5)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1320" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="rb-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1320" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="e2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Écran du briefing [S1]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;frontend/briefing.html, briefing.js&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;un code de valeur (ticker), pas de texte&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;422 → « Valeur introuvable » [S4]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé dans un champ masqué&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1636" y="146" width="300" height="102" as="geometry" /></mxCell>
        <mxCell id="e2-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1636" y="146" width="7" height="102" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;1. Garde-fou de détournement [S4] : injection, changement de rôle, extraction&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;guardrails/detournement.py : MOTIFS_DETOURNEMENT l.32 (règles par famille), verifier_detournement l.69&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;appelé dans rag/recherche.py l.229, avant tout ; reconnu → refus TENTATIVE_DETOURNEMENT, sans modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_garde_fou_question.py (38) · mesuré : 7 hostiles sur 8 avant le modèle ; 0 reformulation sur 8&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="326" width="868" height="84" as="geometry" /></mxCell>
        <mxCell id="a1-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="326" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;2. Garde-fou d&amp;#x27;intention [S1] : le conseil d&amp;#x27;achat ou de vente&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;guardrails/entree.py : MOTIFS_INTENTION_AMF l.33, verifier_intention l.54&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;appelé dans rag/recherche.py l.236 ; reconnu → refus INTENTION_INTERDITE&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="424" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a2-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="424" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;3. Recherche dans les articles [S3] : le hors-périmètre&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;rag/recherche.py : rechercher l.194 ; par le sens et par les mots, 3 passages ; seuil 0.42 l.114&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucun passage assez proche → refus OUT_OF_CORPUS, sans appeler le modèle&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="504" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a3-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="504" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;4. Articles piégés écartés [S4] : l&amp;#x27;injection indirecte&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py : passages_surs l.219 → guardrails/injection.py neutraliser l.46 (12 motifs, l.18)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;passage reconnu → écarté avant le prompt, journal sans son texte · tests/test_article_piege.py (7)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="584" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a4-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="584" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;5. Le prompt [S3] : la question est une donnée, jamais une consigne&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py : construire_prompt l.106, CONSIGNES l.70, _neutraliser l.91&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;question et passages dans des blocs déclarés comme données ; espaces Unicode ramenées à une seule&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="664" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a5-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="664" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a6" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;6. Le modèle [S3] : Azure, zone de données de l&amp;#x27;UE, seul fournisseur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;src/llm.py : generer_json l.137 ; réponse au format JSON imposé ; il peut s&amp;#x27;abstenir (ABSTENTION)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;trace : src/traces.py question l.330, métadonnées seules&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="744" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a6-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="744" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a7" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;7. Citations vérifiées [S3]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py : citations_valides l.55 ; un numéro inventé → refus CITATIONS_INVALIDES&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="824" width="868" height="56" as="geometry" /></mxCell>
        <mxCell id="a7-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="824" width="7" height="56" as="geometry" /></mxCell>
        <mxCell id="a8" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;8. Contrôle de fuite [S4] : clé, jeton, mot de passe, configuration, consignes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py l.279 → guardrails/sortie.py verifier_fuite l.107, MOTIFS_FUITE l.81 ; FUITE_BLOQUEE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_garde_fou_fuite.py (9) · mesuré : 5 sorties dangereuses simulées sur 7, 0 faux positif sur 11&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="894" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a8-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="894" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a9" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;9. Garde-fou AMF [S1] : le conseil d&amp;#x27;achat dans la réponse&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py l.284 → guardrails/sortie.py verifier_sortie l.53, MOTIFS_AMF l.28&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reconnu → refus SORTIE_NON_CONFORME&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="974" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a9-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="974" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a10" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#14532D&quot;&gt;10. Contrôle des nombres [S4] : un chiffre faux sous une source juste&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py l.297 → guardrails/nombres.py nombres_absents l.67 ; absent des sources → NOMBRE_NON_SOURCE&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;tests/test_controle_nombres.py (46) · né du « 1 0 postes » du 20/10 ; ne lit pas les nombres en lettres&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#15803D;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="1054" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a10-bande" value="" style="rounded=0;html=1;fillColor=#15803D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="1054" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="a11" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;11. La réponse citée [S3]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/question.py : _reference l.214 ; chaque référence vient du passage, jamais du texte du modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;fiche de la source : GET /donnees/articles/{id} relit l&amp;#x27;article dans la base&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="1134" width="868" height="66" as="geometry" /></mxCell>
        <mxCell id="a11-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="1134" width="7" height="66" as="geometry" /></mxCell>
