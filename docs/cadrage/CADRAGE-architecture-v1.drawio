        <mxCell id="zp" value="AUTOUR : PILOTAGE ET SIGNAUX (détail : E3-chaine-livraison, E3-monitorage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;dashed=1;align=left;verticalAlign=top;fontSize=13.5;fontStyle=1;fontColor=#0B2A5B;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="896" width="1420" height="130" as="geometry" /></mxCell>
        <mxCell id="src" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Sources (C1), collectées chaque soir&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;services web : BCE (taux de change), FRED (taux US),&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  Yahoo Finance (cours) · page web : Boursorama&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;flux RSS d&amp;#x27;actualité · fichier : positions (CSV)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;big data : archive Parquet (Spark, hors image)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="448" height="112" as="geometry" /></mxCell>
        <mxCell id="src-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="146" width="7" height="112" as="geometry" /></mxCell>
        <mxCell id="nuit" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Collecte du soir, 19 h&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;pipelines/ingest.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;6 étapes indépendantes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;manifeste par exécution&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="316" width="220" height="84" as="geometry" /></mxCell>
        <mxCell id="nuit-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="316" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;PostgreSQL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;10 tables, 1 vue&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;cours, taux, articles,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;positions (RGPD)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="316" y="316" width="188" height="84" as="geometry" /></mxCell>
        <mxCell id="pg-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="316" y="316" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="inj" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;Garde-fou d&amp;#x27;injection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;guardrails/injection.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;relit chaque article&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;bloqué : marqué, gardé&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="496" width="220" height="84" as="geometry" /></mxCell>
        <mxCell id="inj-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="496" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="ch" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#4C1D95&quot;&gt;ChromaDB&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;articles découpés&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;et vectorisés,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;reconstruit chaque soir&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#6D28D9;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="316" y="496" width="188" height="84" as="geometry" /></mxCell>
        <mxCell id="ch-bande" value="" style="rounded=0;html=1;fillColor=#6D28D9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="316" y="496" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="envoi" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Ce qui part chez le fournisseur du modèle&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le prompt seul : cours, variation, indicateurs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;au plus 3 extraits d&amp;#x27;articles ; jamais une position&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="606" width="448" height="66" as="geometry" /></mxCell>
        <mxCell id="envoi-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="56" y="606" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="fixe" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Un chemin fixe, toujours le même&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;graph/workflow.py : scout, rag, redacteur ;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le modèle ne choisit jamais le chemin :&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;chaque briefing se rejoue et se trace&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="146" width="308" height="84" as="geometry" /></mxCell>
        <mxCell id="fixe-bande" value="" style="rounded=0;html=1;fillColor=#475569;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="146" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="scout" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;scout&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;lit PostgreSQL : cours, variation,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;13 indicateurs par valeur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucune position, aucun prix de revient&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="316" width="308" height="84" as="geometry" /></mxCell>
        <mxCell id="scout-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="316" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="ge" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;Garde-fou d&amp;#x27;entrée (début de rag)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;intention AMF refusée avant la recherche&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="420" width="308" height="56" as="geometry" /></mxCell>
        <mxCell id="ge-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="420" width="7" height="56" as="geometry" /></mxCell>
        <mxCell id="rag" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;rag&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;ChromaDB : filtre par valeur,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;recherche hybride dense + BM25&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 passages ; refus si aucun article&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="496" width="308" height="84" as="geometry" /></mxCell>
        <mxCell id="rag-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="496" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="red" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;redacteur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;agents/analyst.py : la consigne,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;interdit AMF écrit dedans&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="600" width="308" height="66" as="geometry" /></mxCell>
        <mxCell id="red-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="600" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="mod" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Modèle fourni : Azure, zone UE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;src/llm.py ; gpt-5.4-dzs-eu&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;LLM_ORDRE=foundry (11/10)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="686" width="308" height="66" as="geometry" /></mxCell>
        <mxCell id="mod-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="686" width="7" height="66" as="geometry" /></mxCell>
        <mxCell id="gs" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#9A3412&quot;&gt;Garde-fou de sortie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;guardrails/sortie.py, échec fermé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;recommandation : texte remplacé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;par un refus, conforme_amf=false&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C2410C;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="576" y="772" width="308" height="84" as="geometry" /></mxCell>
        <mxCell id="gs-bande" value="" style="rounded=0;html=1;fillColor=#C2410C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="576" y="772" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Interface web (frontend/)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 écrans : portefeuille, indicateurs,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;  briefing ; clé saisie à l&amp;#x27;écran&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;verdict AMF écrit en mots&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="146" width="300" height="84" as="geometry" /></mxCell>
        <mxCell id="web-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="956" y="146" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Passerelle MCP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;3 outils en lecture&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;seule, avec la clé&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;aucun accès à /briefing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1272" y="146" width="172" height="84" as="geometry" /></mxCell>
        <mxCell id="mcp-bande" value="" style="rounded=0;html=1;fillColor=#1E293B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1272" y="146" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="routes" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#0B2A5B&quot;&gt;Routes, clé, identifiant de requête&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;GET /health (public) · 11 routes GET /donnees/*&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;POST /briefing?ticker= : le seul chemin vers le modèle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;clé X-API-Key 16 car. min. ; 403 ; X-Request-ID&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F0FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="316" width="488" height="84" as="geometry" /></mxCell>
        <mxCell id="routes-bande" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="956" y="316" width="7" height="84" as="geometry" /></mxCell>
        <mxCell id="j1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;J1 · /health dit sa version&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;le manifeste de version servi&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="420" width="240" height="56" as="geometry" /></mxCell>
        <mxCell id="j1-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="956" y="420" width="7" height="56" as="geometry" /></mxCell>
        <mxCell id="j3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;J3 · valeur inconnue : 422&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sans appel au modèle (502 auj.)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1204" y="420" width="240" height="56" as="geometry" /></mxCell>
        <mxCell id="j3-bande" value="" style="rounded=0;html=1;fillColor=#D32F2F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1204" y="420" width="7" height="56" as="geometry" /></mxCell>
        <mxCell id="j4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px;color:#C62828&quot;&gt;J4 · limite de débit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#111827&quot;&gt;sur POST /briefing (429)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D32F2F;strokeWidth=2;dashed=1;align=left;spacingLeft=14;fontSize=11.5;fontColor=#111827;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="956" y="492" width="240" height="56" as="geometry" /></mxCell>
