        <mxCell id="sub" value="Sprint 1, cadrage V1 · lecture : 1 données → 2 agent et garde-fous → 3 interface → 4 API, puis le pilotage autour" style="text;html=1;align=left;fontSize=15;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1400" height="22" as="geometry" /></mxCell>
