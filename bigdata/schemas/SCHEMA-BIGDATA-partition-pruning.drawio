        <mxCell id="plan" value="&lt;div style=&quot;text-align:left;font-family:Courier New;font-size:9.5px&quot;&gt;PartitionFilters: [isnotnull(annee), (&lt;b&gt;&lt;font color=&quot;#14607F&quot;&gt;annee = 2024&lt;/font&gt;&lt;/b&gt;)]&lt;br&gt;Fichiers connus de Spark : &lt;b&gt;&lt;font color=&quot;#14607F&quot;&gt;11&lt;/font&gt;&lt;/b&gt;  →  un seul est ouvert&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#14607F&quot;&gt;27 648&lt;/font&gt;&lt;/b&gt; lignes extraites sur 276 168&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D5DCE4;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
